<?xml version="1.0" encoding="utf-8"?>
<!--
  发布配置: 一键打包成单个 BiliTouch.exe(自包含, 无需安装 .NET 运行库)
  用法: 在 Visual Studio 中右键项目 -> 发布 -> 选择 FolderProfile -> 发布
  输出: bin\publish\BiliTouch.exe

  ★ 2026-11-05: 文件名与 TargetFramework 一起更新。原来这里残留
    "BiliDesk.exe" 文案 + net8.0-windows(项目早已升到 net10.0-windows)——
    照着这份配置发布出来的东西既叫错名字、又跑在不再支持的运行时上。
    ★ 真正对外发版走仓库根的 发布.ps1(它自己带参数, 不读这份文件),
      这里只是给"在 VS 里点发布"的人留一条正确的路。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DeleteExistingFiles>true</DeleteExistingFiles>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
