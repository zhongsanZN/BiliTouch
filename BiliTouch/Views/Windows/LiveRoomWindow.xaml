<views:FluentWindow x:Class="BiliTouch.Views.LiveRoomWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:BiliTouch.Views"
    xmlns:controls="clr-namespace:BiliTouch.Views.Controls"
    xmlns:helpers="clr-namespace:BiliTouch.Helpers"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="BiliTouch 直播间" Width="1360" Height="840" MinWidth="840" MinHeight="540"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <!--
        ★★★ 2026-11-05 直播间对齐大修。用户原话:
          "直播间重做之后很多东西没有做到对齐, 比如播放详情页有铺满窗口, 直播间相似的东西
           却另做一个按钮放到别的位置。又如播放暂停按钮、声音等等。不过声音这个我觉得可以
           做成点击(触屏)或悬停(鼠标)后才向上展开控制条, 这样就能够节省控制栏空间。
           还有右上角的三大金刚键也是自己乱做一套。"

        这一版把播放页那套**原样**搬过来, 不再各写一份:
          1. 顶栏右侧 → 统一的 controls:WindowButtons(最小化/最大化/关闭), 与播放器同一个控件;
          2. 控制栏 → PlayerRoundBtn / PlayerTextBtn / PlayerSlider(全局样式),
             播放暂停用 PlayerGlyphs 的矢量图标(不再用"Ⅱ"/"▶" 字符);
          3. 音量 → 默认只显示一颗喇叭; 鼠标悬停或手指点一下, **向上**展开音量条
             (不是向右挤占控制栏), 收起时那颗按钮仍然是静音切换;
          4. 铺满窗口 → 与播放器同位置(顶栏右侧、窗口按钮左边)、同图标、同语义。
             直播间的"铺满窗口"= 收起右侧实时弹幕栏, 窗口尺寸不变 ——
             与播放器的"收起右侧信息栏"是同一件事。
          5. 全屏仍然在控制栏最右, 与播放器同位置同图标。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <views:FluentWindow.Resources>
        <!-- 直播间自己的圆按钮 = 全局 PlayerRoundBtn 的别名。
             ★ 必须 BasedOn 全局那份而不是重写模板: 一旦重写, 播放器的暂停键和这里的
               暂停键又会慢慢长成两个样子(这正是用户这次报的问题)。 -->
        <Style x:Key="LiveControl" TargetType="Button" BasedOn="{StaticResource PlayerRoundBtn}">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="40"/>
        </Style>

        <DataTemplate x:Key="ChatTemplate">
            <Border x:Name="MessageBody" Padding="12,7" CornerRadius="8" Margin="2,2">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding User}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnCardBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Identity}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding Identity,Converter={StaticResource StrToVis}}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="SuperChat"><Setter TargetName="MessageBody" Property="Background" Value="{DynamicResource AccentSoftFillStrongBrush}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </views:FluentWindow.Resources>
    <Grid x:Name="Root" Background="{DynamicResource CardBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition x:Name="ChromeRow" Height="44"/><RowDefinition x:Name="HeaderRow" Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <!-- ============ 顶栏: 标题 + 铺满窗口 + 三大金刚键(与播放器同一套) ============ -->
        <Grid x:Name="TitleBar" Margin="16,0,6,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="BiliTouch  /  直播" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- 直播热度胶囊: 播放页这个位置是"听视频/稍后再看"这类即时状态, 直播间放"在看人数"。
                     空值自动隐藏(StrToVis), 不在未开播时占一个占位的坑。 -->
                <Border x:Name="LiveOnlineBox" Margin="0,0,8,0" Padding="10,5"
                        VerticalAlignment="Center" CornerRadius="12"
                        Background="{DynamicResource ControlFillHoverBrush}"
                        Visibility="{Binding Watched,Converter={StaticResource StrToVis}}"
                        ToolTip="当前在看人数">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock x:Name="LiveOnlineText" Text="{Binding Watched}" FontSize="12" Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <!-- 铺满窗口: 与播放器 BtnFillWindow 完全同位同形同语义(收起右侧弹幕栏, 窗口尺寸不变)。
                     ★ 与"全屏"是两件事, 别合并: 全屏会连顶栏一起收起、盖住任务栏。 -->
                <Button x:Name="BtnFillWindow" Style="{StaticResource IconButtonStyle}"
                        Width="34" Height="34"
                        ToolTip="铺满窗口（收起右侧弹幕栏）" Click="FillWindowClick"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock x:Name="FillWindowGlyph" Text="&#xE9A6;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </Button>
                <!-- 最小化 / 最大化 / 关闭: 直接复用播放器那颗控件(WindowButtons) -->
                <controls:WindowButtons Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid x:Name="RoomHeader" Grid.Row="1" Margin="20,6,20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <WrapPanel Margin="0,8,0,0">
                    <Border Background="{DynamicResource AccentSoftFillBrush}" Padding="8,2" CornerRadius="5" Margin="0,0,10,0"><TextBlock Text="{Binding LiveStateText}" FontSize="11" Foreground="{DynamicResource AccentTextOnCardBrush}"/></Border>
                    <TextBlock Text="{Binding Anchor}" Margin="0,2,12,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Area}" Margin="0,2,12,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding RoomText}" Margin="0,2,12,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding Watched}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,10,0" helpers:Cover.Source="{Binding Face}"/>
<TextBlock Text="{Binding Anchor}" VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
<Button x:Name="FollowButton" Content="{Binding FollowText}" Style="{StaticResource AccentButtonStyle}" Click="FollowClick" MinWidth="76"/>
                <Button Content="↗" Style="{StaticResource SubtleButtonStyle}" Click="OpenBrowserClick" ToolTip="在浏览器打开直播间" Margin="8,0,0,0" FontSize="20"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" x:Name="RoomLayout">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ChatColumn" Width="360"/></Grid.ColumnDefinitions>
            <Grid Background="#101116" x:Name="VideoPanel">
                <vlc:VideoView x:Name="LiveVideo" Background="Black" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid x:Name="VideoOverlay" Focusable="True" Background="#01000000" MouseLeftButtonDown="VideoMouseDown"
                          MouseMove="VideoMouseMove" MouseLeave="VideoMouseLeave">
                        <!-- 弹幕层: 底部留 72 给控制栏, 不让弹幕钻到控制栏下面去。
                             ★ 2026-11-05 修"视频弹幕看不见": 原来这里固定 Margin 0,0,0,56, 而
                               控制栏 56 高 —— 弹幕最下面一条正好被控制栏压住一半。改 72 留出余量。 -->
                        <Border x:Name="LiveDim" Background="Black" Opacity="0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="LiveGestureText" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#B0000000" Foreground="White" FontSize="22" Padding="18" IsHitTestVisible="False" Panel.ZIndex="8"/>
                        <Canvas x:Name="LiveCanvas" ClipToBounds="True" IsHitTestVisible="False" Margin="0,0,0,72"/>
                        <StackPanel x:Name="PlaybackState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                            <Image Source="/BiliTouch;component/Assets/app.png" Width="64" Height="64" Margin="0,0,0,16"/>
                            <TextBlock x:Name="PlaybackStateText" Text="正在连接直播…" Foreground="White" FontSize="19" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Content="重新连接" Click="ReconnectClick" Style="{StaticResource LiveControl}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 音量上展面板(2026-11-05 用户要求)。
                             ★ 为什么向上展开而不是横在控制栏里: 控制栏本来就要塞 暂停/回到实时/
                               清晰度/弹幕/弹幕设置/侧栏/全屏 七颗, 再横着放一条 78px 的滑杆,
                               窗口一窄就被挤压。翻上去只借用画面空白, 控制栏宽度不变。
                             ★ 触发方式: 鼠标悬停喇叭 → 自动展开; 触屏点喇叭 → 切换展开
                               (手指没有 hover)。收回时那颗按钮仍然是静音开关。
                             ★ 面板是独立 Popup(Runtime 侧控制 IsOpen): 不能用 Visibility ——
                               它要浮在视频 HWND 之上, Popup 是唯一的可靠办法。 -->
                        <Popup x:Name="VolumePopup" Placement="Top" StaysOpen="True" AllowsTransparency="True"
                               PopupAnimation="Fade" VerticalOffset="-8">
                            <Border Background="#F0202226" CornerRadius="10" Padding="12,10"
                                    BorderBrush="#33FFFFFF" BorderThickness="1" Width="196">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="VolumePopupText" DockPanel.Dock="Right" Text="80%"
                                                   Foreground="#99FFFFFF" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="音量" Foreground="#E6FFFFFF" FontSize="12" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Slider x:Name="LiveVolume" Style="{StaticResource PlayerSlider}"
                                            Minimum="0" Maximum="100" ValueChanged="VolumeChanged"
                                            ToolTip="音量" IsMoveToPointEnabled="True" Focusable="False"/>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <!-- ============ 底部控制栏: 与播放器同一形态 ============ -->
                        <Border x:Name="LiveControls" VerticalAlignment="Bottom" BorderThickness="0" Padding="14,6,14,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#00000000" Offset="0" />
                                    <GradientStop Color="#66000000" Offset="0.45" />
                                    <GradientStop Color="#D9000000" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <!-- 进度行位置: 直播没有进度条, 这里放"直播中 + 观看人数"。
                                     ★ 保留这一行是为了让操作行的高度与播放器**完全一致** ——
                                       播放器那边有一条 40 高的滑杆, 少这一行的话两边的按钮
                                       垂直位置会差 40px, 切换窗口时一眼能看出来。 -->
                                <Grid MinHeight="40">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                                        <Border Style="{StaticResource LiveOnAirBadgeStyle}">
                                            <TextBlock x:Name="OnAirText" Text="直播中" FontSize="11"
                                                       Foreground="#FFFFD9E6" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock x:Name="WatchedText" Text="{Binding Watched}" Margin="10,0,0,0"
                                                   FontSize="11" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="ConnectionBadge" Text="{Binding ConnectionText}"
                                                   Margin="10,0,0,0" FontSize="11" Foreground="#80FFFFFF"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                                <!-- 操作行 -->
                                <Grid Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><!-- 播放/暂停 -->
                                        <ColumnDefinition Width="Auto"/><!-- 回到实时 -->
                                        <ColumnDefinition Width="*"/><!-- 占位, 把右侧的推到右边 -->
                                        <ColumnDefinition Width="Auto"/><!-- 音量 -->
                                        <ColumnDefinition Width="Auto"/><!-- 清晰度 -->
                                        <ColumnDefinition Width="Auto"/><!-- 画面弹幕 -->
                                        <ColumnDefinition Width="Auto"/><!-- 弹幕设置 -->
                                        <ColumnDefinition Width="Auto"/><!-- 侧栏 -->
                                        <ColumnDefinition Width="Auto"/><!-- 全屏 -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 播放/暂停: 与播放器 OnPlayPauseClick 完全同形同图标 -->
                                    <Button x:Name="PauseButton" Grid.Column="0" Style="{StaticResource LiveControl}"
                                            Width="36" Height="36" Click="PauseClick" ToolTip="暂停 / 继续（空格）">
                                        <helpers:SkinActionIcon Kind="Play" x:Name="PauseGlyph" Fill="White" Width="15" Height="15" Stretch="Uniform"
                                              Data="{x:Static helpers:PlayerGlyphs.PlayGeometry}"/>
                                    </Button>
                                    <!-- 回到实时画面(= 播放器的"重播/刷新"位置): 直播暂停后要能一键回实时 -->
                                    <Button Grid.Column="1" Click="ReconnectClick" Style="{StaticResource LiveControl}"
                                            Width="36" Height="36" ToolTip="回到实时画面 / 重新连接">
                                        <helpers:SkinGlyph Kind="Refresh" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Tint="White"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="White" VerticalAlignment="Center"/></helpers:SkinGlyph>
                                    </Button>

                                    <!-- 音量: 喇叭 + 向上展开的滑杆 -->
                                    <Button Grid.Column="3" x:Name="MuteButton" Style="{StaticResource LiveControl}"
                                            Width="36" Height="36" Click="MuteClick"
                                            MouseEnter="VolumeHoverEnter" MouseLeave="VolumeHoverLeave"
                                            ToolTip="点击静音 / 悬停或点一下展开音量条">
                                        <helpers:SkinGlyph Kind="Volume" IconSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Tint="White" State="{Binding Text,ElementName=VolumeGlyphText}"><TextBlock x:Name="VolumeGlyphText" Text="&#xE767;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="White"/></helpers:SkinGlyph>
                                    </Button>
                                    <!-- 清晰度: 播放器同款 PlayerTextBtn -->
                                    <Button Grid.Column="4" x:Name="QualityButton" Style="{StaticResource PlayerTextBtn}"
                                            Margin="4,0,0,0" Click="QualityClick" ToolTip="切换直播清晰度">
                                        <StackPanel Orientation="Horizontal"><helpers:SkinGlyph Kind="Quality" IconSize="24" Tint="White"/><TextBlock x:Name="QualityText" Text="原画" Foreground="#F2FFFFFF"/></StackPanel>
                                    </Button>
                                    <Popup x:Name="QualityPopup" Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="#F0202226" CornerRadius="8" Padding="6"
                                                BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="110">
                                            <ListBox x:Name="QualityList" Background="Transparent" BorderThickness="0"
                                                     Foreground="White" SelectionChanged="QualityChanged">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <!-- ★ 绝不能设 Focusable=False: ListBoxItem 鼠标按下时
                                                             Focus() 失败会短路选中逻辑(项目里踩过) -->
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                                        <Setter Property="Padding" Value="10,6"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate><TextBlock Text="{Binding}" Foreground="#F2FFFFFF"/></DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Border>
                                    </Popup>

                                    <!-- 画面弹幕开关: 与播放器 BtnDanmaku 同一份几何(Themes/Icons.xaml) -->
                                    <Button Grid.Column="5" x:Name="OverlayButton" Style="{StaticResource LiveControl}"
                                            Width="36" Height="36" Margin="4,0,0,0" Click="OverlayClick"
                                            ToolTip="画面弹幕开关">
                                        <Grid Width="22" Height="20">
                                            <Path x:Name="DanmakuGlyph" Stroke="White" StrokeThickness="1.6"
                                                  StrokeLineJoin="Round" Data="{StaticResource DanmakuIconGeometry}"/>
                                            <Path x:Name="OverlayOff" Stroke="White" StrokeThickness="2"
                                                  Data="{StaticResource DanmakuOffSlashGeometry}" Visibility="Collapsed"/>
                                            <Path x:Name="DanmakuGlyphHolder" Visibility="Collapsed"/>
                                        </Grid>
                                    </Button>
                                    <!-- 弹幕设置: 与播放器同位置(弹幕开关右边) -->
                                    <Button Grid.Column="6" x:Name="LiveSettingsButton" Style="{StaticResource PlayerTextBtn}"
                                            Margin="4,0,0,0" Click="OverlaySettingsClick" ToolTip="弹幕设置">
                                        <helpers:SkinGlyph Kind="DanmakuSettings" IconSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Tint="White"><TextBlock Text="弹幕设置" Foreground="#F2FFFFFF"/></helpers:SkinGlyph>
                                    </Button>
                                    <Popup x:Name="LiveSettingsPopup" PlacementTarget="{Binding ElementName=LiveSettingsButton}"
                                           Placement="Top" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="#F0202226" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                CornerRadius="10" Padding="12,10" Width="248">
                                            <StackPanel>
                                                <TextBlock Text="弹幕设置" Foreground="#E6FFFFFF" FontSize="12"/>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="显示区域" Style="{StaticResource DanmakuRowLabelStyle}"/>
                                                    <Slider Grid.Column="1" x:Name="AreaSetting" Style="{StaticResource PlayerSlider}"
                                                            Minimum="25" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True"
                                                            Margin="6,0,6,0" ValueChanged="OverlaySettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="AreaValue" Text="25%"
                                                               Style="{StaticResource DanmakuRowValueStyle}"/>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="不透明度" Style="{StaticResource DanmakuRowLabelStyle}"/>
                                                    <Slider Grid.Column="1" x:Name="OpacitySetting" Style="{StaticResource PlayerSlider}"
                                                            Minimum="20" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                                            Margin="6,0,6,0" ValueChanged="OverlaySettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="OpacityValue" Text="80%"
                                                               Style="{StaticResource DanmakuRowValueStyle}"/>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="字号" Style="{StaticResource DanmakuRowLabelStyle}"/>
                                                    <Slider Grid.Column="1" x:Name="FontSetting" Style="{StaticResource PlayerSlider}"
                                                            Minimum="50" Maximum="200" TickFrequency="25" IsSnapToTickEnabled="True"
                                                            Margin="6,0,6,0" ValueChanged="OverlaySettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="FontValue" Text="100%"
                                                               Style="{StaticResource DanmakuRowValueStyle}"/>
                                                </Grid>
                                                <Grid Margin="0,10,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="速度" Style="{StaticResource DanmakuRowLabelStyle}"/>
                                                    <Slider Grid.Column="1" x:Name="SpeedSetting" Style="{StaticResource PlayerSlider}"
                                                            Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                            Margin="6,0,6,0" ValueChanged="OverlaySettingChanged"/>
                                                    <TextBlock Grid.Column="2" x:Name="SpeedValue" Text="适中"
                                                               Style="{StaticResource DanmakuRowValueStyle}"/>
                                                </Grid>
                                                <CheckBox x:Name="ColorSetting" Content="彩色弹幕" Margin="0,12,0,0"
                                                          Foreground="#E6FFFFFF" Checked="ColorSettingChanged" Unchecked="ColorSettingChanged"/>
                                                <TextBlock Text="屏蔽词沿用设置页中的弹幕规则" FontSize="11"
                                                           Foreground="#80FFFFFF" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>

                                    <Button Grid.Column="7" x:Name="LiveEnhancementButton" Content="增强" Visibility="Collapsed" Width="44" Style="{StaticResource PlayerTextBtn}" Click="LiveEnhancementClick" AutomationProperties.Name="画质增强" />
                                    <!-- 侧边弹幕面板 -->

                                    <!-- 全屏: 与播放器 BtnFullscreen2 同位置(最右)、同码位 -->
                                    <Button Grid.Column="8" x:Name="FullscreenButton" Style="{StaticResource LiveControl}"
                                            Width="36" Height="36" Margin="4,0,0,0" Click="FullscreenClick"
                                            ToolTip="全屏（F / 双击画面），Esc 退出">
                                        <TextBlock Text="&#xE740;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="14" Foreground="White"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </vlc:VideoView>
            </Grid>

            <Border Grid.Column="1" x:Name="ChatPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="16,14,12,10">
                        <Button DockPanel.Dock="Right" Content="清屏" Style="{StaticResource SubtleButtonStyle}" Click="ClearChatClick" MinHeight="28" FontSize="11"/>
                        <StackPanel><TextBlock Text="实时弹幕" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <Expander Grid.Row="1" Header="直播公告" Margin="16,0,16,8" Visibility="{Binding Announcement,Converter={StaticResource StrToVis}}">
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Announcement}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8"/></ScrollViewer>
                    </Expander>
                    <Border Grid.Row="2" Background="{DynamicResource AccentSoftFillBrush}" Margin="12,0,12,8" Padding="10" CornerRadius="10" Visibility="{Binding HasSuperChats,Converter={StaticResource BoolToVis}}">
                        <StackPanel><TextBlock Text="醒目留言 · SC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnCardBrush}" Margin="2,0,0,6"/>
                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ActiveSuperChats}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Padding="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,3" CornerRadius="6"><StackPanel>
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/><TextBlock Foreground="{DynamicResource AccentTextOnCardBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding PriceText,Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding User,Mode=OneWay}"/></TextBlock></DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="ChatList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.ScrollChanged="ChatScrollChanged" PreviewMouseWheel="ChatWheel" PreviewTouchDown="ChatTouchDown">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button x:Name="LatestButton" Content="回到最新弹幕" Click="LatestClick" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="16,8,16,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Visibility="{Binding StatusText,Converter={StaticResource StrToVis}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" FontSize="11" Visibility="{Binding Error,Converter={StaticResource StrToVis}}"/>
                    </StackPanel>
                    <Grid Grid.Row="5" Margin="12,10,12,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Style="{StaticResource FluentTextBoxStyle}" MinHeight="40" MaxLength="100" VerticalContentAlignment="Center" KeyDown="ChatInputKeyDown" ToolTip="发送直播弹幕（最多 100 字，Enter 发送）"/>
                        <Button x:Name="SendButton" Grid.Column="1" Content="发送" Style="{StaticResource AccentButtonStyle}" Click="SendClick" IsEnabled="{Binding IsSending,Converter={StaticResource InvBool}}" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</views:FluentWindow>
