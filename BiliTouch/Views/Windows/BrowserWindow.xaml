<views:FluentWindow x:Class="BiliTouch.Views.BrowserWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliTouch.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Title="网页浏览" Width="1180" Height="780"
             MinWidth="800" MinHeight="500" WindowStartupLocation="CenterOwner">
    <!-- 删掉与系统标题栏重复的 44px 自绘网址栏, 标题跟随 SourceChanged 更新, 右下角注入系统浏览器入口 -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <wv2:WebView2 x:Name="Wv" />
    </Grid>
</views:FluentWindow>