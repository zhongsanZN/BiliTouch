<UserControl xmlns:helpers="clr-namespace:BiliTouch.Helpers" x:Class="BiliTouch.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <!-- Four primary pages share a full-width, fixed header; settings content scrolls below it. -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="{x:Static helpers:PageHeaderMetrics.HeaderRow}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="SettingsHeader">
            <Grid.RowDefinitions><RowDefinition Height="{x:Static helpers:PageHeaderMetrics.TitleRow}"/><RowDefinition Height="{x:Static helpers:PageHeaderMetrics.TabsRow}"/></Grid.RowDefinitions>
            <helpers:SkinSurface Grid.RowSpan="2" Kind="Home"/>
            <TextBlock x:Name="ShellPageTitle" Text="应用设置" Style="{StaticResource PageTitleStyle}" Margin="{x:Static helpers:PageHeaderMetrics.TitleMargin}" VerticalAlignment="Top"/>
                <helpers:NavigationTabs Grid.Row="1" HorizontalAlignment="Left" Margin="{x:Static helpers:PageHeaderMetrics.TabsMargin}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="SettingsTab" Style="{StaticResource UnderlineTabStyle}"
                                     Content="通用"
                                     IsChecked="{Binding IsGeneralTab, Mode=TwoWay}" />
                        <RadioButton GroupName="SettingsTab" Style="{StaticResource UnderlineTabStyle}"
                                     Content="播放" Margin="2,0,0,0"
                                     IsChecked="{Binding IsPlaybackTab, Mode=TwoWay}" />
                        <RadioButton GroupName="SettingsTab" Style="{StaticResource UnderlineTabStyle}"
                                     Content="数据管理" Margin="2,0,0,0"
                                     IsChecked="{Binding IsDataTab, Mode=TwoWay}" />
                        <RadioButton GroupName="SettingsTab" Style="{StaticResource UnderlineTabStyle}"
                                     Content="关于" Margin="2,0,0,0"
                                     IsChecked="{Binding IsAboutTab, Mode=TwoWay}" />
                    </StackPanel>
                </helpers:NavigationTabs>
        </Grid>
        <ScrollViewer FocusVisualStyle="{x:Null}" Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,8,0">
        <StackPanel Margin="36,12,36,32">
            <!-- ============ 内容区 ============
                 Tab 切换 = ContentControl + DataTriggers 换 ContentTemplate。
                 ★ Content 必须保持是 **VM 本身**({Binding}): 模板里所有 Command / 属性绑定
                   都以 Content 为数据源 —— 之前把它设成 "{Binding TabIndex}"(一个 int),
                   所有按钮的绑定就全落空了(真机症状: 四个 Tab 的功能全没反应)。
                   Triggers 只负责读 TabIndex 换模板, 不动 Content。 -->
            <ContentControl Margin="0,4,0,0" HorizontalAlignment="Stretch"
                            Focusable="False"
                            Content="{Binding}">
                <ContentControl.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="Settings/SettingsTabs.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource GeneralTabTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TabIndex}" Value="1">
                                <Setter Property="ContentTemplate" Value="{StaticResource PlaybackTabTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TabIndex}" Value="2">
                                <Setter Property="ContentTemplate" Value="{StaticResource DataTabTemplate}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding TabIndex}" Value="3">
                                <Setter Property="ContentTemplate" Value="{StaticResource AboutTabTemplate}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
