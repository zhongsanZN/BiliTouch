<UserControl x:Class="BiliTouch.Views.Pages.CachePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:helpers="clr-namespace:BiliTouch.Helpers" xmlns:controls="clr-namespace:BiliTouch.Views.Controls"
 Background="{DynamicResource AppBackgroundBrush}" SizeChanged="OnCachePageSizeChanged">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <helpers:SkinSurface Kind="Home" Grid.RowSpan="2"/>
  <Grid Margin="36,20,36,12" MinHeight="62">
   <StackPanel>
    <TextBlock x:Name="ShellPageTitle" Text="离线缓存" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <Button Content="导入已有视频" Command="{Binding ImportCommand}" Style="{StaticResource SubtleButtonStyle}" MinHeight="40" Margin="0,0,8,0"/>
    <Button Content="打开缓存文件夹" Command="{Binding OpenFolderCommand}" Style="{StaticResource SubtleButtonStyle}" MinHeight="40" Margin="0,0,8,0"/>
    <Button Content="管理" Command="{Binding ToggleEditCommand}" Style="{StaticResource SubtleButtonStyle}" MinHeight="40"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="36,0,36,12">
   <StackPanel Visibility="{Binding IsOverview,Converter={StaticResource BoolToVis}}">
    <StackPanel Orientation="Horizontal">
     <RadioButton Content="已缓存" IsChecked="{Binding IsCompletedTab}" GroupName="OfflineState" Style="{StaticResource SettingsTabStyle}"/>
     <RadioButton Content="正在缓存" IsChecked="{Binding IsDownloadingTab}" GroupName="OfflineState" Style="{StaticResource SettingsTabStyle}" Margin="8,0,0,0"/>
    </StackPanel>
    <TextBlock Text="{Binding CacheDirectory,StringFormat=缓存位置：{0}}" Margin="0,10,0,0" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap"/>
   </StackPanel>
   <Grid Visibility="{Binding IsDetailView,Converter={StaticResource BoolToVis}}" Margin="0,2,0,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Button Command="{Binding BackFromGroupCommand}" Style="{StaticResource SubtleButtonStyle}" MinHeight="40" Padding="14,6" VerticalAlignment="Center" Margin="0,0,14,0">
     <StackPanel Orientation="Horizontal">
      <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBlock Text="返回合集列表" VerticalAlignment="Center"/>
     </StackPanel>
    </Button>
    <StackPanel Grid.Column="1" VerticalAlignment="Center">
     <TextBlock Text="{Binding SelectedGroup.Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
     <TextBlock Text="{Binding SelectedGroup.DetailSummary}" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="36,0,36,24">
   <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="{Binding IsEditMode,Converter={StaticResource BoolToVis}}">
    <WrapPanel VerticalAlignment="Center">
     <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
     <Button Content="全选" Command="{Binding SelectAllCommand}" Style="{StaticResource SubtleButtonStyle}" MinHeight="40"/>
     <Button Content="删除所选" Command="{Binding DeleteSelectedCommand}" Style="{StaticResource DangerButtonStyle}" MinHeight="40" Margin="8,0"/>
     <Button Content="完成" Command="{Binding ExitEditCommand}" Style="{StaticResource SubtleButtonStyle}" MinHeight="40"/>
    </WrapPanel>
   </Border>
   <Grid>
    <controls:FeedStatusOverlay Panel.ZIndex="2" IsLoading="{Binding Loading}" IsEmpty="{Binding ShowEmpty}" ErrorText="{Binding Error}" EmptyText="{Binding EmptyText}"/>
    <!-- 一级视图：多集/分P已自动折叠，每行两列紧凑卡片 -->
    <ScrollViewer x:Name="OverviewScroll" Visibility="{Binding IsOverview,Converter={StaticResource BoolToVis}}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="GroupList" ItemsSource="{Binding VisibleGroups}" Margin="0,0,-12,0">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <UniformGrid x:Name="GroupColumnsPanel" Columns="2" VerticalAlignment="Top" Loaded="OnGridPanelLoaded"/>
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
               CornerRadius="12" Padding="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="148" Height="84" CornerRadius="8" Background="{DynamicResource PlaceholderBrush}" ClipToBounds="True">
          <Grid>
           <Border CornerRadius="8" helpers:Cover.Source="{Binding Cover}"/>
           <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Padding="7,2" CornerRadius="5"
                   Background="#CC14161A" Visibility="{Binding HasBadge,Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
           </Border>
          </Grid>
         </Border>
         <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding Author}" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}"/>
          <TextBlock Text="{Binding PreviewText}" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
         </StackPanel>
         <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource LabeledCheckBoxStyle}" Content="选择" MinHeight="40" Click="OnSelectionClick" Visibility="{Binding DataContext.IsEditMode,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolToVis}}"/>
          <Button Content="{Binding ActionText}" Command="{Binding DataContext.ActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SubtleButtonStyle}" MinHeight="36" Padding="10,5" Visibility="{Binding DataContext.IsEditMode,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource InvBoolToVis}}"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>

    <!-- 二级视图：点进合集/多P后展示所有分集，同样两列排版 -->
    <ScrollViewer x:Name="DetailScroll" Visibility="{Binding IsDetailView,Converter={StaticResource BoolToVis}}"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl x:Name="EpisodeList" ItemsSource="{Binding SelectedGroup.Episodes}" Margin="0,0,-12,0">
      <ItemsControl.ItemsPanel>
       <ItemsPanelTemplate>
        <UniformGrid x:Name="EpisodeColumnsPanel" Columns="2" VerticalAlignment="Top" Loaded="OnGridPanelLoaded"/>
       </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
               CornerRadius="12" Padding="12" Margin="0,0,12,12" Cursor="Hand" MouseLeftButtonUp="OnCardClick">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Width="136" Height="78" CornerRadius="8" Background="{DynamicResource PlaceholderBrush}" ClipToBounds="True">
          <Grid>
           <Border CornerRadius="8" helpers:Cover.Source="{Binding Cover}"/>
           <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Padding="6,2" CornerRadius="4" Background="#CC14161A">
            <TextBlock Text="{Binding Page,StringFormat=P{0}}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F2FFFFFF"/>
           </Border>
          </Grid>
         </Border>
         <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding DisplayPartTitle}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock Text="{Binding QualityText}" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}"/>
          <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <ProgressBar Value="{Binding Percent,Mode=OneWay}" Maximum="100" Height="3" Margin="0,6,0,0" Visibility="{Binding IsComplete,Converter={StaticResource InvBoolToVis}}"/>
         </StackPanel>
         <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource LabeledCheckBoxStyle}" Content="选择" MinHeight="40" Click="OnSelectionClick" Visibility="{Binding DataContext.IsEditMode,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource BoolToVis}}"/>
          <Button Content="{Binding ActionText}" Command="{Binding DataContext.ActionCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource SubtleButtonStyle}" MinHeight="36" Padding="10,5" Visibility="{Binding DataContext.IsEditMode,RelativeSource={RelativeSource AncestorType=UserControl},Converter={StaticResource InvBoolToVis}}"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
   </Grid>
  </DockPanel>
 </Grid>
</UserControl>
