<UserControl x:Class="BiliTouch.Views.Pages.MineOverviewPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:helpers="clr-namespace:BiliTouch.Helpers" xmlns:controls="clr-namespace:BiliTouch.Views.Controls"
 Background="{DynamicResource AppBackgroundBrush}">
 <Grid>
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoggedIn,Converter={StaticResource InvBoolToVis}}">
   <TextBlock Text="你的个人主页" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
   <TextBlock Text="登录后查看个人资料和自己的投稿" Margin="0,12,0,18" Foreground="{DynamicResource TextSecondaryBrush}"/>
   <Button Content="登录" Command="{Binding LoginCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" MinHeight="44" Padding="28,8"/>
  </StackPanel>
  <ScrollViewer x:Name="ProfileScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScrollChanged" Visibility="{Binding IsLoggedIn,Converter={StaticResource BoolToVis}}">
   <StackPanel Margin="36,8,36,28">
    <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="26" Margin="0,0,0,24">
      <helpers:SkinProfileLayout x:Name="ProfileSkinLayout">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="88" Height="88" CornerRadius="44" Background="{DynamicResource AccentSoftFillBrush}" VerticalAlignment="Top"><Border CornerRadius="44" helpers:Cover.Source="{Binding Face}"/></Border>
      <StackPanel Grid.Column="1" Margin="22,0,0,0">
       <TextBlock Text="{Binding Name}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding Mid,StringFormat=UID：{0}}" Margin="0,6,0,0" Foreground="{DynamicResource TextTertiaryBrush}"/>
       <TextBlock Text="{Binding Sign}" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
       <WrapPanel Margin="-10,14,0,0">
        <Button x:Name="FollowingButton" Style="{StaticResource SubtleButtonStyle}" MinHeight="44" Padding="10,6" Click="OnFollowing" ToolTip="查看全部关注"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FollowingText}" FontSize="14"/><TextBlock Text=" 关注" FontSize="14"/></StackPanel></Button>
        <Button x:Name="FollowersButton" Style="{StaticResource SubtleButtonStyle}" MinHeight="44" Padding="10,6" Margin="4,0,0,0" Click="OnFollowers" ToolTip="查看粉丝"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding FollowersText}" FontSize="14"/><TextBlock Text=" 粉丝" FontSize="14"/></StackPanel></Button>
        <Button Style="{StaticResource SubtleButtonStyle}" MinHeight="44" Padding="10,6" Margin="4,0,0,0" Click="OnCreations"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding VideoCountText}" FontSize="14"/><TextBlock Text=" 投稿" FontSize="14"/></StackPanel></Button>
       </WrapPanel>
      </StackPanel>
      </Grid>
      </helpers:SkinProfileLayout>
    </Border>
    <TextBlock x:Name="CreationsTitle" Text="我的投稿" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,14" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding Error,Converter={StaticResource StrToVis}}"/>
    <TextBlock Text="还没有投稿。这里会展示你自己的作品。" Margin="0,24" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding ShowEmpty,Converter={StaticResource BoolToVis}}"/>
    <ItemsControl ItemsSource="{Binding Videos}">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel helpers:CardWall.Enable="True"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate><controls:VideoCard Margin="0,0,16,20"/></DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <controls:LoadingRing Width="28" Height="28" Margin="0,14" HorizontalAlignment="Center" Visibility="{Binding Loading,Converter={StaticResource BoolToVis}}"/>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</UserControl>
