<UserControl xmlns:helpers="clr-namespace:BiliTouch.Helpers" helpers:TrackpadScroll.IsFeed="True" x:Class="BiliTouch.Views.Pages.MinePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="{DynamicResource AppBackgroundBrush}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="{x:Static helpers:PageHeaderMetrics.TitleRow}"/><RowDefinition Height="{x:Static helpers:PageHeaderMetrics.TabsRow}"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<helpers:SkinSurface Kind="Home" Grid.RowSpan="2"/>

  <TextBlock x:Name="ShellPageTitle" Text="我的" Style="{StaticResource PageTitleStyle}" Margin="{x:Static helpers:PageHeaderMetrics.TitleMargin}" VerticalAlignment="Top" />
  <helpers:NavigationTabs Grid.Row="1" HorizontalAlignment="Left" Margin="{x:Static helpers:PageHeaderMetrics.TabsMargin}"><StackPanel Orientation="Horizontal">
   <RadioButton x:Name="OverviewTab" Content="个人主页" Tag="0" GroupName="MineSections" Checked="OnTabChecked"/>
   <RadioButton x:Name="HistoryTab" Content="历史" Tag="1" GroupName="MineSections" Checked="OnTabChecked"/>
   <RadioButton x:Name="FavoritesTab" Content="收藏" Tag="2" GroupName="MineSections" Checked="OnTabChecked"/>
   <RadioButton x:Name="LaterTab" Content="稍后再看" Tag="3" GroupName="MineSections" Checked="OnTabChecked"/>
   <RadioButton x:Name="CacheTab" Content="缓存" Tag="4" GroupName="MineSections" Checked="OnTabChecked"/>
  </StackPanel></helpers:NavigationTabs>
  <Grid x:Name="SectionHost" Grid.Row="2" ClipToBounds="True" Background="Transparent"/>
 </Grid>
</UserControl>
