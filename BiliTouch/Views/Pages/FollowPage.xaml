<UserControl x:Class="BiliTouch.Views.Pages.FollowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliTouch.Views.Controls"
             xmlns:helpers="clr-namespace:BiliTouch.Helpers"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- 综合 / 视频模式与新动态提示共用的按钮样式。 -->
        <Style x:Key="FeedLayoutChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{DynamicResource ControlFillDefaultBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ★ 2026-11-05 左栏 UP 主排序用的三枚 chip(最近更新 / 未读优先 / 关注顺序)。

            为什么另起一个 key 而不是直接复用上面那个:
              上面那枚的 Padding 是 9,3 —— 在左栏(252 宽)里三枚并排会挤到换行。
              这里收窄到 7,4 并压掉最小宽度, 三枚正好落在一行内(RUN 时量过 232 可用宽)。
              触发器/配色完全照抄, 只在 Tag="on" 时的观感与它保持一致 —— 用户看上去是同一套控件。

            ★ 文字必须是**显式 TextBlock** 而不是 Content="…":
              全局隐式 <Style TargetType="TextBlock"> 带 Foreground setter, 而 WPF 的优先级是
              Style setter > 继承, 于是它会压过 ContentPresenter 透传下来的 TextElement.Foreground ——
              chip 选中时粉字会被吃成灰字。这里 Content 是显式 TextBlock, 它的 Foreground 走
              RelativeSource 绑定到 Button.Foreground(局部值), 优先级最高, 不会被隐式样式盖掉。
              播放页评论排序的 chip 就是这么写的, 照抄。
        -->
        <Style x:Key="FollowSortChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏「全部标记已读」的小按钮: 无底, 悬停才铺一层浅灰 —— 它是辅助操作, 不该抢排序 chip 的注意力。
             ★ 文字同样显式写 TextBlock + Foreground 绑定, 理由同上(隐式 TextBlock 样式会吃前景色)。
             ★ MarkAllReadFlash 由 VM 在点完 1.6 秒内保持 true, 那时整块变粉底(确认感)。 -->
        <Style x:Key="FollowMarkReadButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillPressedBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding MarkAllReadFlash}" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="{x:Static helpers:PageHeaderMetrics.HeaderRow}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
<helpers:SkinSurface Kind="Home" Grid.Row="0"/>


        <!-- 标题 + 刷新 -->
        <!--
                    右上角的窗口按钮(最小化/最大化/关闭)浮在内容区之上、占 y=4~36。
                    头部因此撑到 68 高: 标题贴顶(和左侧 logo 同一水平线), 右侧操作按钮
                    贴底 —— 它们的顶边落在 44, 正好让开窗口按钮, 谁也不压谁。
                -->
        <Grid x:Name="FollowHeader" Grid.Row="0" Margin="{x:Static helpers:PageHeaderMetrics.TitleMargin}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DockPanel VerticalAlignment="Top" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Left" x:Name="ShellPageTitle" Text="动态" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Count, StringFormat=' · 关注 {0} 位 UP'}"
                           VerticalAlignment="Bottom" Margin="6,0,0,6" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </DockPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,24,0,0">
                <Button x:Name="NewDynamicsButton" MinHeight="44" Margin="0,0,8,0"
                        Content="{Binding NewDynamicsText}" Click="OnApplyNewDynamics" ToolTip="点击显示新动态">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource FeedLayoutChipStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasNewDynamics}" Value="True"/>
                                <Condition Binding="{Binding ShowContent}" Value="True"/>
                            </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 发布动态(2026-11-04): 客户端内直接发, 不再跳网页。
                     ★ 放在刷新按钮左边: 主操作优先, 刷新是辅助操作。
                     ★ 未登录时禁用而不是隐藏 —— 隐藏会让人以为客户端没有这个功能。 -->
                <Button x:Name="PublishDynamicButton" Style="{StaticResource SubtleButtonStyle}" MinHeight="44" Padding="14,7" Margin="0,0,8,0"
                        Click="OnPublishClick" ToolTip="发一条新动态"
                        IsEnabled="{Binding IsLoggedInForPublish}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="发布动态" FontSize="12.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="FollowRefreshButton" Width="44" Height="44" Style="{StaticResource IconButtonStyle}"
                        Command="{Binding RefreshCommand}" ToolTip="刷新">
                    <helpers:SkinGlyph Kind="Refresh" IconSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="15" /></helpers:SkinGlyph>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <!-- 未登录提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding NotLoggedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="登录后可查看你关注的 UP 主的动态"
                           Margin="0,14,0,14" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="20,8"
                        Command="{Binding LoginCommand}" />
            </StackPanel>

            <!-- 加载中(整页) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFullLoading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing HorizontalAlignment="Center" />
                <TextBlock Text="加载中…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 主体: 左 UP 列表 + 右内容 ===== -->
            <Grid Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左: 全部动态 + UP 列表 ===== -->
                <Grid x:Name="ContactsScroll" Grid.Column="0"
                              Margin="12,4,0,20">
                    <Grid Margin="8,0,8,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <!-- ===== 排序 + 未读汇总(2026-11-05 新增) =====
                             用户原话"没看懂动态的 up 主排序怎么做的, 未读已读机制好像也没做好"。
                             所以这里把规则**摆在界面上**: 三枚 chip 直接写明这档怎么排(悬浮说明说全),
                             下面一行汇总"几个 UP 有更新" + 一键全部标记已读。
                             ★ 位置在左栏**顶部、全部动态入口之前**: 排序作用于整个列表,
                               放列表中间会让人以为只管下面那几个。
                             ★ 选中态由 VM 的 SortTagXxx 三件套驱动(只在一处决定), 见 FollowViewModel。 -->
                        <StackPanel Margin="28,6,2,2">


                            <!-- 汇总徽标 + 全部标记已读: 同一行, 没有未读时徽标整块隐藏但按钮留着
                                 (按钮是"我确认都看过了"的手动出口, 不该跟着红点有无而忽隐忽现)。 -->
                            <WrapPanel Margin="0,4,0,0">
                                <Border DockPanel.Dock="Left" CornerRadius="8" Padding="7,2" VerticalAlignment="Center"
                                        Background="{DynamicResource DangerBrush}"
                                        ToolTip="B 站返回这些 UP 有未读更新；读取后同步刷新已读状态"
                                        Visibility="{Binding HasUnreadSummary, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding UnreadSummary}" FontSize="10.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnDangerBrush}" />                                </Border>
                                <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                        x:Name="MarkAllReadButton" Style="{StaticResource FollowMarkReadButtonStyle}"
                                        Command="{Binding MarkAllReadCommand}"
                                        IsEnabled="{Binding HasFollowUsers}"
                                        ToolTip="把当前所有 UP 的已读基准推到各自最新一条">
                                    <TextBlock x:Name="MarkAllReadLabel" Text="{Binding MarkAllReadText}" FontSize="11.5"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </WrapPanel>
                        </StackPanel>

                        <!-- 全部动态入口: 选中高亮跟 VM.IsAllSelected 走 -->
                        <!-- 选中/悬停观感与左侧导航栏一致: 悬停灰(NavItemHoverBrush),
                             选中粉底(AccentSoftFillBrush) + 粉字(AccentTextBrush)。 -->
                        <!-- ★ 左内边距 28 = 6(UP 行左内边距) + 22(红点通道): 这样「全部动态」的
                             图标与下方各 UP 的头像落在同一条竖线上, 不会因为红点通道而错位。 -->
                        <Border Grid.Row="1" CornerRadius="10" Padding="28,10,12,10" Margin="0,4,0,6" Cursor="Hand"
                                Tag="AllDynamics" MouseLeftButtonUp="OnSelectAll">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="helpers:ContactSelection.SuppressHover" Value="False"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}"/></MultiTrigger>
                                        <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{DynamicResource AccentSoftFillBrush}">
                                    <Path Data="{DynamicResource DynamicIconGeometry}"
                                          Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="全部动态" FontSize="14" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 关注的 UP(点击 = 只看 TA 的投稿) -->
                        <ListBox x:Name="ContactsList" Grid.Row="2" ItemsSource="{Binding Users}" Background="Transparent" BorderThickness="0"
                                  ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <controls:ContactListRow Title="{Binding Name}" Avatar="{Binding Face}" IsSelected="{Binding IsSelected}" HasUnread="{Binding HasNew}" MouseLeftButtonUp="OnSelectUp" ToolTip="只看 TA 的动态">
                                     <controls:ContactListRow.ContextMenu><ContextMenu><MenuItem Header="打开 UP 主页" Click="OnVisitClick"/></ContextMenu></controls:ContactListRow.ContextMenu>
                                    </controls:ContactListRow>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 左栏补页 -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6"
                                    Visibility="{Binding LoadingUsers, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="14" Height="14" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== 右: 内容(两档排版, 右上角可切) ===== -->
                <Grid x:Name="FollowFeedBody" Grid.Column="1" Margin="12,4,24,20" AutomationProperties.Name="{Binding SelectionTitle}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- ===== 关注直播看板(2026-10-31 新增) =====
                         我关注的主播里正在播的, 一行一个: 头像 + 名字 + 直播标题。
                         ★ 点整行 → 直接进 TA 的直播间(Svc.Player.PlayLive), 不经任何中间页。
                         ★ **常驻显示**(2026-10-31 用户问"看板在哪里" —— 之前做成"没人在播就整块
                           隐藏", 结果用户找不到这个功能; 空态改成一行说明文字, 位置固定可预期)。
                           未登录才整块隐藏(登录了才有"关注"可言)。
                         ★ 展开态可折叠(点标题行切换), 数据与动态流并行加载。 -->
                    <Border x:Name="FollowLiveBoard" Grid.Row="0" Margin="8,0,8,10" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotLoggedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- 标题行: 点它折叠/展开 -->
                            <Button x:Name="LiveBoardToggle" Click="OnToggleLiveBoard" Cursor="Hand"
                                    HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0"
                                    AutomationProperties.Name="展开或收起关注直播" ToolTip="展开或收起关注直播">
                                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter /></Border></ControlTemplate></Button.Template>
                                <Grid Background="Transparent">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="{Binding LiveBoardTitle}" FontSize="13" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <controls:LoadingRing Width="14" Height="14" Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding LiveBoardLoading, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- 展开箭头(收起时转 180°) -->
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding LiveBoardOpen, Converter={StaticResource BoolToAngle}}" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                </Grid>
                            </Button>
                            <!-- 主播列表(竖排, 一行一个); 空态给一行说明 —— 看板常驻后
                                 "为什么列表是空的"要自己解释清楚, 不然像坏了 -->
                            <ItemsControl ItemsSource="{Binding LiveNow}" Margin="0,8,0,0"
                                          Visibility="{Binding LiveBoardOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="6,6" Margin="0,0,0,4" Cursor="Hand"
                                                ToolTip="进入直播间"
                                                MouseLeftButtonUp="OnLiveItemClick">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 头像 + 直播中角标(红点在头像右下角, 照 B 站直播面板) -->
                                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                        Background="{DynamicResource AccentSoftFillBrush}" ClipToBounds="True"
                                                        helpers:Cover.Source="{Binding Cover}"
                                                        ToolTip="{Binding Title}">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Title}" FontSize="11.5" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <!-- 「直播中」标 -->
                                                <Border Grid.Column="2" CornerRadius="4" Padding="5,2"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource DangerBrush}">
                                                    <TextBlock Text="直播中" FontSize="9.5" FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- 空态: 加载完成且没人在播(加载中不显示, 由标题行的 ring 表达) -->
                            <TextBlock Text="关注的主播暂时都没有在直播"
                                       FontSize="12" Margin="0,8,0,2"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding ShowLiveEmptyText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <DockPanel Grid.Row="1" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,10">
                                <Button x:Name="AllFeedModeButton" Style="{StaticResource FeedLayoutChipStyle}"
                                        MinHeight="36" MinWidth="64" Margin="0,0,8,0"
                                        Tag="{Binding FeedTagAll}" Command="{Binding ShowAllFeedCommand}">
                                    <TextBlock Text="综合" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button x:Name="VideoFeedModeButton" Style="{StaticResource FeedLayoutChipStyle}"
                                        MinHeight="36" MinWidth="64" Tag="{Binding FeedTagVideo}"
                                        Command="{Binding ShowVideoFeedCommand}" ToolTip="只看视频投稿">
                                    <TextBlock Text="视频" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                            <!-- 出错/为空提示(非阻断, 放在列表上方) -->
                            <Border DockPanel.Dock="Top" HorizontalAlignment="Center" MaxWidth="520"
                                    Margin="4,4,4,10" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource InfoBarBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                                    Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                            Margin="16,0,0,0" Padding="10,4"
                                            Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- 底部状态 -->
                            <!-- ★★★ 2026-11-08 删掉这里的「加载更多」按钮（用户："底部莫名其妙的加载更多没啥用"）：
                                 往下滚到底已经会自动补下一页（见 FeedScroll_OnScrollChanged → LoadMoreFeedAsync），
                                 那个按钮只是在页脚常驻一个能点但没有新增信息的东西 —— 而且它用的是 DockPanel.Dock=Bottom，
                                 永远贴在窗口底边，跟"列表滚到哪"没有关系，看着就像个不知从哪冒出来的杂项。
                                 现在底部只留两件事：正在自动加载的转圈、"已经到底啦"。
                                 ★ 首页也走过同一条路（HomePage 的「加载更多」同样因为自动加载而删除），保持一致。 -->
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,8" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                                    <controls:LoadingRing Width="18" Height="18" />
                                    <TextBlock Text="加载中…" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                           Visibility="{Binding HasMore, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                            <Grid x:Name="FollowFeedHost" ClipToBounds="True">
                            <ScrollViewer x:Name="VideoFeedScroll" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding ShowVideoFeed, Converter={StaticResource BoolToVis}}"
                                          ScrollChanged="FeedScroll_OnScrollChanged">
                                <ItemsControl ItemsSource="{Binding VideoFeed}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <helpers:VirtualizingCardWallPanel helpers:CardWall.Enable="True" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><controls:VideoCard DataContext="{Binding Video}" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <ListBox x:Name="DynamicList" ItemsSource="{Binding Dynamics}"
                                     Visibility="{Binding ShowDynamicFeed, Converter={StaticResource BoolToVis}}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.ScrollChanged="FeedScroll_OnScrollChanged"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate><controls:DynamicFeedCard MaxWidth="760" /></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </Grid>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
