<UserControl x:Class="BiliTouch.Views.Pages.ArticlePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliTouch.Views.Controls"
             xmlns:helpers="clr-namespace:BiliTouch.Helpers"
             xmlns:local="clr-namespace:BiliTouch.Views.Pages"
             Background="{DynamicResource AppBackgroundBrush}"
             PreviewKeyDown="OnPagePreviewKeyDown"
             SizeChanged="OnPageSizeChanged">
    <UserControl.Resources>
        <Style x:Key="CommentReactionText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLiked}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ReplyTemplate">
            <Border Margin="0,6,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource ControlFillHoverBrush}">
                <StackPanel>
                    <controls:CommentText Comment="{Binding}" Prefix="{Binding ReplyPrefix}" FontSize="13"
                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Button Content="回复" Click="OnReplyToReply" HorizontalAlignment="Left"
                            Style="{StaticResource SubtleButtonStyle}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HeadingBlockTemplate">
            <TextBlock Text="{Binding Text}" FontSize="{Binding HeadingFontSize}" FontWeight="Bold"
                       TextWrapping="Wrap" Margin="0,18,0,8" LineHeight="28"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="ParagraphBlockTemplate">
            <TextBlock helpers:ArticleRichText.Block="{Binding}" FontSize="15" LineHeight="26"
                       TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="QuoteBlockTemplate">
            <Border Margin="0,4,0,14" Padding="14,10" CornerRadius="0,8,8,0"
                    Background="{DynamicResource ControlFillHoverBrush}"
                    BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="3,0,0,0">
                <TextBlock helpers:ArticleRichText.Block="{Binding}" FontSize="14" LineHeight="24"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ListItemBlockTemplate">
            <Grid Margin="6,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ListMarker}" FontSize="14.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Grid.Column="1" helpers:ArticleRichText.Block="{Binding}" FontSize="15" LineHeight="25"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="DividerBlockTemplate">
            <Border Height="1" Margin="20,16" Background="{DynamicResource CardBorderBrush}" />
        </DataTemplate>

        <DataTemplate x:Key="CodeBlockTemplate">
            <Border Margin="0,4,0,14" Padding="12" CornerRadius="8"
                    Background="{DynamicResource ControlFillHoverBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding CodeLanguage}" FontSize="11.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="复制代码" Click="OnCopyCode"
                                HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}"
                                Padding="8,3" FontSize="11.5" />
                    </DockPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                 FontFamily="Consolas, Microsoft YaHei UI" FontSize="13" Padding="0" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ImageBlockTemplate">
            <StackPanel Margin="0,6,0,16">
                <Border CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                        Background="{DynamicResource PlaceholderBrush}"
                        MouseLeftButtonUp="OnArticleImageClick">
                    <Image helpers:Cover.ImageDecodeWidth="1200" helpers:Cover.ImageSource="{Binding ImageUrl}"
                           Stretch="Uniform" MaxHeight="560" HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding ImageCaption}" Visibility="{Binding HasImageCaption, Converter={StaticResource BoolToVis}}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           FontSize="12.5" Margin="0,6,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="VideoCardBlockTemplate">
            <Border Margin="0,6,0,14" Padding="10" CornerRadius="10" Cursor="Hand"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    MouseLeftButtonUp="OnArticleVideoClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="156" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Height="92" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource PlaceholderBrush}">
                        <Grid>
                            <Image helpers:Cover.ImageDecodeWidth="360" helpers:Cover.ImageSource="{Binding Video.Cover}" Stretch="UniformToFill" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" Padding="5,2"
                                    CornerRadius="4" Background="#B0000000"
                                    Visibility="{Binding Video.Duration, Converter={StaticResource StrToVis}}">
                                <TextBlock Text="{Binding Video.Duration}" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,2,0,2" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" Padding="6,2" CornerRadius="4" Margin="0,0,0,6"
                                Background="{DynamicResource AccentSoftFillBrush}">
                            <TextBlock Text="关联视频" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                        </Border>
                        <TextBlock Text="{Binding Video.Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"
                                   MaxHeight="42" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Video.Author}" FontSize="12" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Video.Author, Converter={StaticResource StrToVis}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <local:ArticleBlockTemplateSelector x:Key="ArticleBlockSelector"
            HeadingTemplate="{StaticResource HeadingBlockTemplate}"
            ParagraphTemplate="{StaticResource ParagraphBlockTemplate}"
            QuoteTemplate="{StaticResource QuoteBlockTemplate}"
            ListItemTemplate="{StaticResource ListItemBlockTemplate}"
            DividerTemplate="{StaticResource DividerBlockTemplate}"
            CodeTemplate="{StaticResource CodeBlockTemplate}"
            ImageTemplate="{StaticResource ImageBlockTemplate}"
            VideoCardTemplate="{StaticResource VideoCardBlockTemplate}" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="*" />
            <ColumnDefinition x:Name="RightColumn" Width="400" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="*" />
            <RowDefinition x:Name="BottomRow" Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 左栏：专栏正文阅读区 -->
        <ScrollViewer x:Name="ArticleScroll" Grid.Column="0" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel MaxWidth="780" HorizontalAlignment="Center">
                <!-- 顶部横幅封面 -->
                <Border Margin="0,0,0,16" CornerRadius="10" ClipToBounds="True" MaxHeight="300"
                        Background="{DynamicResource PlaceholderBrush}"
                        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
                    <Image helpers:Cover.ImageDecodeWidth="1280" helpers:Cover.ImageSource="{Binding BannerUrl}"
                           Stretch="UniformToFill" />
                </Border>

                <!-- 标题 + 元信息 -->
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap"
                           LineHeight="34" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding MetaLine}" FontSize="12.5" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding MetaLine, Converter={StaticResource StrToVis}}" />

                <!-- 作者信息与快捷操作栏 -->
                <Border Margin="0,14,0,16" Padding="12" CornerRadius="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="OnAuthorClick"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasAuthor, Converter={StaticResource BoolToVis}}">
                            <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True"
                                    Background="{DynamicResource PlaceholderBrush}">
                                <Image helpers:Cover.ImageDecodeWidth="96" helpers:Cover.ImageSource="{Binding AuthorFace}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AuthorName}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="点击进入 UP 主主页" FontSize="11.5"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="OnLikeArticle" Style="{StaticResource SubtleButtonStyle}" Padding="10,6" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal">
                                    <helpers:SkinActionIcon Kind="Like" IsActive="{Binding IsLiked}" Width="16" Height="16"
                                                            Margin="0,0,5,0" Fill="{DynamicResource TextSecondaryBrush}"
                                                            Data="{StaticResource LikeIconGeometry}" />
                                    <TextBlock Text="{Binding LikeText}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnFavoriteArticle" Style="{StaticResource SubtleButtonStyle}" Padding="10,6" Margin="0,0,6,0"
                                    Visibility="{Binding CanFavorite, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding FavoriteText}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Button>
                            <Button Content="复制链接" Click="OnCopyLink" Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,6" Margin="0,0,6,0"
                                    Visibility="{Binding CanonicalUrl, Converter={StaticResource StrToVis}}" />
                            <Button Content="浏览器打开" Click="OnOpenWeb" Style="{StaticResource SubtleButtonStyle}"
                                    Padding="10,6"
                                    Visibility="{Binding CanonicalUrl, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 加载中与错误状态 -->
                <StackPanel Orientation="Horizontal" Margin="0,12" HorizontalAlignment="Center"
                            Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                    <controls:LoadingRing Width="20" Height="20" />
                    <TextBlock Text="正在加载专栏正文…" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Border Margin="0,8,0,16" Padding="12" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundBrush}"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DangerTextBrush}" />
                        <Button Content="重试" Click="OnRetryLoadArticle" Margin="12,0,0,0"
                                Style="{StaticResource AccentButtonStyle}" Padding="12,4" />
                    </StackPanel>
                </Border>

                <!-- 正文内容块列表 -->
                <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplateSelector="{StaticResource ArticleBlockSelector}" />

                <Border Height="24" />
            </StackPanel>
        </ScrollViewer>

        <!-- 右栏：评论区 -->
        <Border x:Name="CommentPane" Grid.Column="1" Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 评论头部与排序切换 -->
                <DockPanel Margin="14,12,14,8">
                    <TextBlock Text="{Binding CommentHeaderText}" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton Content="最热" GroupName="ArticleCommentSort" IsChecked="{Binding IsHotSort, Mode=OneWay}"
                                     Click="OnSortHot" Style="{StaticResource SegmentTabStyle}" Margin="0,0,4,0" />
                        <RadioButton Content="最新" GroupName="ArticleCommentSort" IsChecked="{Binding IsLatestSort, Mode=OneWay}"
                                     Click="OnSortLatest" Style="{StaticResource SegmentTabStyle}" />
                    </StackPanel>
                </DockPanel>

                <!-- 评论列表 -->
                <ListBox x:Name="CommentList" Grid.Row="1" ItemsSource="{Binding Comments}"
                         BorderThickness="0" Background="Transparent" Padding="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.ScrollChanged="OnCommentScrollChanged"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,4" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" CornerRadius="8" Background="{DynamicResource ControlFillHoverBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Cursor="Hand" MouseLeftButtonUp="OnCommentAuthorClick">
                                        <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True"
                                                Background="{DynamicResource PlaceholderBrush}">
                                            <Image helpers:Cover.ImageDecodeWidth="72" helpers:Cover.ImageSource="{Binding Avatar}" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Text="{Binding UserName}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
                                        <TextBlock Text="置顶" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    <controls:CommentText Comment="{Binding}" Margin="0,6,0,0" FontSize="13"
                                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Pictures}" Margin="0,4,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="86" Height="76" Margin="3" CornerRadius="4" ClipToBounds="True"
                                                        helpers:Cover.Source="{Binding Url}" MouseLeftButtonUp="OnCommentPicture" Cursor="Hand" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Text="{Binding RcTime}" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
                                        <Button Click="OnLikeComment" IsEnabled="{Binding CanLike}" ToolTip="点赞"
                                                Style="{StaticResource SubtleButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <helpers:SkinActionIcon Kind="Like" IsActive="{Binding IsLiked}" Width="14" Height="14"
                                                                        Margin="0,0,4,0" Fill="{DynamicResource TextSecondaryBrush}"
                                                                        Data="{StaticResource LikeIconGeometry}" />
                                                <TextBlock Text="{Binding LikeText}" FontSize="12" Style="{StaticResource CommentReactionText}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="回复" Click="OnReplyComment" Style="{StaticResource SubtleButtonStyle}" Margin="6,0" FontSize="12" />
                                        <Button Content="{Binding ExpandRepliesText}" Click="OnLoadReplies"
                                                Visibility="{Binding HasMoreReplies, Converter={StaticResource BoolToVis}}"
                                                Style="{StaticResource SubtleButtonStyle}" FontSize="12" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Replies}" ItemTemplate="{StaticResource ReplyTemplate}" Margin="16,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 底部发表评论框 -->
                <Border Grid.Row="2" Margin="10" Padding="10" CornerRadius="10"
                        Background="{DynamicResource ControlFillHoverBrush}">
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Status, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding ComposerError}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   Visibility="{Binding ComposerError, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding CommentLoadError}" TextWrapping="Wrap" FontSize="12"
                                   Foreground="{DynamicResource DangerTextBrush}"
                                   Visibility="{Binding CommentLoadError, Converter={StaticResource StrToVis}}" />
                        <Button Content="重试加载评论" Click="OnRetryComments" HorizontalAlignment="Left"
                                Visibility="{Binding CommentLoadError, Converter={StaticResource StrToVis}}"
                                Style="{StaticResource SubtleButtonStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4"
                                    Visibility="{Binding HasReplyTarget, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ComposerTitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            <Button Content="取消" Click="OnCancelReply" Style="{StaticResource SubtleButtonStyle}" Margin="6,0" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="Composer" Style="{StaticResource FluentTextBoxStyle}"
                                         Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="84"
                                         MaxLength="1000" VerticalScrollBarVisibility="Auto"
                                         IsEnabled="{Binding CanEdit}" PreviewKeyDown="OnComposerKey"
                                         ToolTip="Ctrl+Enter 发送" />
                                <TextBlock Text="说点什么…" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding Draft, Converter={StaticResource InvStrToVis}}" />
                            </Grid>
                            <Button Grid.Column="1" Content="发送" Click="OnSendComment" Margin="8,0,0,0" VerticalAlignment="Bottom"
                                    Style="{StaticResource AccentButtonStyle}" IsEnabled="{Binding CanEdit}" Padding="14,8" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
