<UserControl x:Class="BiliTouch.Views.Controls.FeedStatusOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliTouch.Views.Controls"
             x:Name="Root">
    <Grid>
        <StackPanel x:Name="LoadingPanel" Orientation="Horizontal"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed">
            <controls:LoadingRing Width="20" Height="20" />
            <TextBlock x:Name="LoadingLabel"
                       Text="{Binding LoadingText, ElementName=Root}"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource MetaTextStyle}" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="480" Visibility="Collapsed">
            <TextBlock Text="{Binding ErrorText, ElementName=Root}"
                       Style="{StaticResource MetaTextStyle}"
                       HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <Button x:Name="RetryButton" Content="重试"
                    Style="{StaticResource SubtleButtonStyle}"
                    Margin="0,12,0,0" HorizontalAlignment="Center"
                    Command="{Binding RetryCommand, ElementName=Root}" />
        </StackPanel>

        <TextBlock x:Name="EmptyLabel"
                   Text="{Binding EmptyText, ElementName=Root}"
                   Style="{StaticResource MetaTextStyle}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
