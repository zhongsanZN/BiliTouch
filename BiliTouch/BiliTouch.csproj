<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标使用 WinForms 的 NotifyIcon：托盘交互（气泡/双击/右键菜单）最省事且稳定，
         比手写 Shell_NotifyIcon P/Invoke 少几百行 marshalling 代码 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BiliTouch</RootNamespace>
    <AssemblyName>BiliTouch</AssemblyName>
    <AssemblyTitle>BiliTouch</AssemblyTitle>
    <Product>BiliTouch</Product>
    <Authors>中三</Authors>
    <Version>0.3.5</Version>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      RollForward=Major: 框架依赖版(安装器)在机器上没有 .NET 10 桌面运行时、
      但装了更高大版本(如 .NET 11)时, 允许直接跑在上面, 不再强求用户装对应版本的
      Desktop Runtime。(Major 语义是滚到*最低*的可用大版本), 不会一觉醒来换到没验证过的最新版本。
      便携版自包含, 此属性对它无影响。安装器侧的检测逻辑同步放在 Publish\installer.iss。

      ★ 2026-10-31 目标框架 net8.0-windows → net10.0-windows: .NET 8 桌面运行时
        2026-11 停止支持, 依赖框架的安装器版从此要求 .NET 10+(检测下限同步改为 10)。
    -->
    <RollForward>Major</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 不跟随引用程序集拷贝 .xml/.pdb 等文档/符号文件（避免带入 WebView2 约 0.8MB XML 文档） -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!--
      关闭 LibVLC 的 x86 原生库（约 126.7MB 纯冗余）。
      VideoLAN.LibVLC.Windows 的 targets 按 $(Platform) 判别，$(Platform) 为 AnyCPU 时默认开启 x86；
      本工程是 x64-only（PlatformTarget=x64），因此显式关闭 x86 与 arm64，并显式开启 x64。
    -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <!--
      ★★★ 必须显式打开 x64 那一份, 不能再靠 targets 自己推导(2026-10-11 修的"视频无法播放")。
      为什么: VideoLAN.LibVLC.Windows 的 targets 判据是
          '$(Platform)' == 'x64' OR '$(Platform)' == 'AnyCPU'
      注意它写的是 **AnyCPU(无空格)**。而本仓库的构建命令一直写
          dotnet build ... -p:Platform="Any CPU"   ← 带空格
      ⇒ $(Platform) 变成 'Any CPU', 与 'AnyCPU' 不相等, 两个开关都落空
      ⇒ 原生库**一个都不复制**, 输出目录里没有 libvlc/, 程序一开视频就报
         "Failed to load required native libraries"。
      ★ 危害在于它**静默**: 构建成功(0 错误 0 警告), 只是产物少了一整个目录;
        而且不同构建入口结果还不一样 —— 用 .sln 构建时 Platform 会被映射成 AnyCPU(正常),
        直接构建 .csproj 或被别的工程 ProjectReference 带出来时才是 'Any CPU'(异常)。
      所以这里把 x64 显式写死(本工程是 x64-only, PlatformTarget=x64),
      无论外面怎么拼 Platform, 原生库都照常复制。
      ★ 别把它"顺手"删掉改回依赖推导 —— 那就是把这个错误再种一遍。
    -->
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <!--
      ★ 3.0.24 的 targets 新增了 ARM64 那一份, 默认判据与 x86 相同(AnyCPU 时自动开) ——
      不显式关掉它, 90MB 的 arm64 原生库会被静默带进发布包(1.5.0 首发踩过:
      setup 20.7MB → 46.4MB), 本工程 x64-only, 与上面的 x86 开关同款处理。    -->
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!--
    UseWindowsForms 会向每个文件注入 System.Windows.Forms / System.Drawing 全局 using，
    与 WPF 的 KeyEventArgs / MouseEventArgs / Point 大面积撞名。本项目仅托盘服务使用
    WinForms 且采用全限定名，因此摘除这两条全局 using。
  -->
  <ItemGroup>
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\app.ico" Link="Assets\BiliTouch-$(Version).ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\upstream-original.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS-LICENSE.txt" />
    <Content Include="Assets\Fonts\HarmonyOS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Cursors\*.cur" />
    <Resource Include="Assets\Skins\StarParty\*.png" />
    <Resource Include="Assets\Skins\PhantomBladeZero\*.png" />
    <Resource Include="Assets\Audio\PhantomBladeZero\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="LibVLCSharp" Version="3.8.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- ★ 3.0.20 → 3.0.24(2026-10-31 修"所有视频破音/爆音"): 3.0.21~3.0.24 累积了一整批
         Windows 音频输出(mmdevice/WASAPI)修复 —— 线程模型重写、nonblocking play 重写、
         缓冲 underrun 修复, 3.0.24 更新说明明确写有 "Fixes Windows audio crashes";
         同时内置 FFmpeg 从 4.4 升到 8.1.2(AAC 解码三年的改进)。升级后必须实测
         DASH 双流(input-slave)与短视频本地合流两条路(见 VlcCore.Get 的注释)。 -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!--
    LibVLC 原生库部署说明：
    VideoLAN.LibVLC.Windows 将原生库输出到 <OutDir>/libvlc/win-x64/（含 plugins/），
    VlcCore 通过 Core.Initialize(<绝对路径>) 显式加载该目录下的 libvlc.dll 与同级 plugins/。
    发布时裁剪 B 站客户端用不到的采集/光盘/流媒体推流/纯编码器/VLC 自带 GUI 插件（约 -30MB），
    完整保留解码（avcodec/dav1d）、解封装（mp4/mkv/ts/adaptive）、输出（d3d11/d3d11va/dxva2/mmdevice/wasapi）、
    访问（http/https/file）、字幕（libass/freetype）、缩放（swscale）与打包（packetizer）。
  -->
  <Target Name="KeepVlcNativeFilesExternal" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup><FilesToBundle Condition="$([System.String]::Copy('%(FilesToBundle.RelativePath)').StartsWith('libvlc'))"><ExcludeFromSingleFile>true</ExcludeFromSingleFile></FilesToBundle></ItemGroup>
  </Target>
  <Target Name="TrimLibVLCPlugins" AfterTargets="Publish">
    <ItemGroup>
      <_VlcTrimDir Include="$(PublishDir)libvlc\win-x64\plugins\gui;
                          $(PublishDir)libvlc\win-x64\plugins\visualization;
                          $(PublishDir)libvlc\win-x64\plugins\stream_out;
                          $(PublishDir)libvlc\win-x64\plugins\access_output;
                          $(PublishDir)libvlc\win-x64\plugins\services_discovery;
                          $(PublishDir)libvlc\win-x64\plugins\lua;
                          $(PublishDir)libvlc\win-x64\plugins\mux;
                          $(PublishDir)libvlc\win-x64\plugins\meta_engine;
                          $(PublishDir)libvlc\win-x64\lua;
                          $(PublishDir)libvlc\win-x64\hrtfs" />
      <_VlcTrimFile Include="$(PublishDir)libvlc\win-x64\plugins\codec\libx264_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libx26410b_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libx265_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libaom_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libtwolame_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libshine_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libschroedinger_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libtheora_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libzvbi_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libaribsub_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libaccess_srt_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libvnc_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdcp_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\liblibbluray_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libbluray-j2se-1.3.2.jar;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdshow_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdtv_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libsftp_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libcdda_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\librtp_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\liblive555_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libnfs_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdvdnav_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdvdread_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\demux\libsid_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\demux\libgme_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\demux\libmod_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\audio_filter\libspatialaudio_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\audio_filter\libmad_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\video_output\libcaca_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\spu\libremoteosd_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\misc\libxml_plugin.dll;
                           $(PublishDir)libvlc\win-x64\libvlc.lib;
                           $(PublishDir)libvlc\win-x64\libvlccore.lib;
                           $(PublishDir)libvlc\win-x64\libvlc.exp;
                           $(PublishDir)libvlc\win-x64\libvlccore.exp;
                           $(PublishDir)BiliTouch.pdb" />
    </ItemGroup>
    <RemoveDir Directories="@(_VlcTrimDir)" />
    <Delete Files="@(_VlcTrimFile)" />
    <Message Text="LibVLC 插件已裁剪，仅保留播放必需模块" Importance="high" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="TouchTests" />
  </ItemGroup>
</Project>
