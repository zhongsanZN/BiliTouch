<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标使用 WinForms 的 NotifyIcon：托盘交互（气泡/双击/右键菜单）最省事且稳定，
         比手写 Shell_NotifyIcon P/Invoke 少几百行 marshalling 代码 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BiliTouch</RootNamespace>
    <AssemblyName>BiliTouch</AssemblyName>
    <AssemblyTitle>BiliTouch</AssemblyTitle>
    <Product>BiliTouch</Product>
    <Authors>中三</Authors>
    <Version>0.3.11</Version>
    <!-- 按目标 RID/Platform 选择架构：默认 x64；指定 -r win-arm64 或 Platform=ARM64 时切换原生 ARM64（面向 ARM 版 Surface） -->
    <IsArm64Target>false</IsArm64Target>
    <IsArm64Target Condition="'$(RuntimeIdentifier)' == 'win-arm64' OR '$(Platform)' == 'ARM64'">true</IsArm64Target>
    <PlatformTarget Condition="'$(IsArm64Target)' != 'true'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(IsArm64Target)' == 'true'">ARM64</PlatformTarget>
    <_VlcRid Condition="'$(IsArm64Target)' != 'true'">win-x64</_VlcRid>
    <_VlcRid Condition="'$(IsArm64Target)' == 'true'">win-arm64</_VlcRid>
    <!--
      RollForward=Major: 框架依赖版(安装器)在机器上没有 .NET 10 桌面运行时、
      但装了更高大版本(如 .NET 11)时, 允许直接跑在上面, 不再强求用户装对应版本的
      Desktop Runtime。(Major 语义是滚到*最低*的可用大版本), 不会一觉醒来换到没验证过的最新版本。
      便携版自包含, 此属性对它无影响。安装器侧的检测逻辑同步放在 Publish\installer.iss。

      ★ 2026-10-31 目标框架 net8.0-windows → net10.0-windows: .NET 8 桌面运行时
        2026-11 停止支持, 依赖框架的安装器版从此要求 .NET 10+(检测下限同步改为 10)。
    -->
    <RollForward>Major</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 不跟随引用程序集拷贝 .xml/.pdb 等文档/符号文件（避免带入 WebView2 约 0.8MB XML 文档） -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!--
      显式按目标架构开关 LibVLC 原生库，绝不依赖 targets 的 AnyCPU 推导（避免 'Any CPU' 空格导致零复制，也防止跨架构 ~90MB 冗余库混入）。
    -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsX64Enabled Condition="'$(IsArm64Target)' != 'true'">true</VlcWindowsX64Enabled>
    <VlcWindowsX64Enabled Condition="'$(IsArm64Target)' == 'true'">false</VlcWindowsX64Enabled>
    <VlcWindowsArm64Enabled Condition="'$(IsArm64Target)' == 'true'">true</VlcWindowsArm64Enabled>
    <VlcWindowsArm64Enabled Condition="'$(IsArm64Target)' != 'true'">false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!--
    UseWindowsForms 会向每个文件注入 System.Windows.Forms / System.Drawing 全局 using，
    与 WPF 的 KeyEventArgs / MouseEventArgs / Point 大面积撞名。本项目仅托盘服务使用
    WinForms 且采用全限定名，因此摘除这两条全局 using。
  -->
  <ItemGroup>
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
    <Resource Include="Assets\app.ico" />
    <Content Include="Assets\app.ico" Link="Assets\BiliTouch-$(Version).ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\upstream-original.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\HarmonyOS-LICENSE.txt" />
    <Content Include="Assets\Fonts\HarmonyOS-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Cursors\*.cur" />
    <Resource Include="Assets\Skins\StarParty\*.png" />
    <Resource Include="Assets\Skins\PhantomBladeZero\*.png" />
    <Resource Include="Assets\Audio\PhantomBladeZero\*.wav" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D9" Version="3.8.3" />
    <PackageReference Include="LibVLCSharp" Version="3.8.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- ★ 3.0.20 → 3.0.24(2026-10-31 修"所有视频破音/爆音"): 3.0.21~3.0.24 累积了一整批
         Windows 音频输出(mmdevice/WASAPI)修复 —— 线程模型重写、nonblocking play 重写、
         缓冲 underrun 修复, 3.0.24 更新说明明确写有 "Fixes Windows audio crashes";
         同时内置 FFmpeg 从 4.4 升到 8.1.2(AAC 解码三年的改进)。升级后必须实测
         DASH 双流(input-slave)与短视频本地合流两条路(见 VlcCore.Get 的注释)。 -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <!--
    LibVLC 原生库部署说明：
    VideoLAN.LibVLC.Windows 将原生库输出到 <OutDir>/libvlc/win-x64/（含 plugins/），
    VlcCore 通过 Core.Initialize(<绝对路径>) 显式加载该目录下的 libvlc.dll 与同级 plugins/。
    发布时裁剪 B 站客户端用不到的采集/光盘/流媒体推流/纯编码器/VLC 自带 GUI 插件（约 -30MB），
    完整保留解码（avcodec/dav1d）、解封装（mp4/mkv/ts/adaptive）、输出（d3d11/d3d11va/dxva2/mmdevice/wasapi）、
    访问（http/https/file）、字幕（libass/freetype）、缩放（swscale）与打包（packetizer）。
  -->
  <Target Name="KeepVlcNativeFilesExternal" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup><FilesToBundle Condition="$([System.String]::Copy('%(FilesToBundle.RelativePath)').StartsWith('libvlc'))"><ExcludeFromSingleFile>true</ExcludeFromSingleFile></FilesToBundle></ItemGroup>
  </Target>
  <Target Name="TrimLibVLCPlugins" AfterTargets="Publish">
    <ItemGroup>
      <_VlcTrimDir Include="$(PublishDir)libvlc\$(_VlcRid)\plugins\gui;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\visualization;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\stream_out;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\access_output;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\services_discovery;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\lua;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\mux;
                          $(PublishDir)libvlc\$(_VlcRid)\plugins\meta_engine;
                          $(PublishDir)libvlc\$(_VlcRid)\lua" />
      <_VlcTrimFile Include="$(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libx264_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libx26410b_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libx265_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libaom_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libtwolame_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libshine_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libschroedinger_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libtheora_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libzvbi_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\codec\libaribsub_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libaccess_srt_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libvnc_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libdcp_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\liblibbluray_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libbluray-j2se-1.3.2.jar;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libdshow_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libdtv_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libsftp_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libcdda_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\librtp_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\liblive555_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libnfs_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libdvdnav_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\access\libdvdread_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\demux\libsid_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\demux\libgme_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\demux\libmod_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\audio_filter\libmad_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\video_output\libcaca_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\spu\libremoteosd_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\plugins\misc\libxml_plugin.dll;
                           $(PublishDir)libvlc\$(_VlcRid)\libvlc.lib;
                           $(PublishDir)libvlc\$(_VlcRid)\libvlccore.lib;
                           $(PublishDir)libvlc\$(_VlcRid)\libvlc.exp;
                           $(PublishDir)libvlc\$(_VlcRid)\libvlccore.exp;
                           $(PublishDir)BiliTouch.pdb" />
    </ItemGroup>
    <RemoveDir Directories="@(_VlcTrimDir)" />
    <Delete Files="@(_VlcTrimFile)" />
    <Message Text="LibVLC 插件已裁剪（$(_VlcRid)），仅保留播放必需模块" Importance="high" />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="TouchTests" />
  </ItemGroup>
</Project>
