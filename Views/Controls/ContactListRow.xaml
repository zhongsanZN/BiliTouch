<UserControl x:Class="BiliTouch.Views.Controls.ContactListRow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:helpers="clr-namespace:BiliTouch.Helpers" x:Name="Root">
 <Border CornerRadius="10" Padding="6,8,12,8" Margin="0,0,0,4" Cursor="Hand">
  <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent"/>
   <Style.Triggers>
    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="helpers:ContactSelection.SuppressHover" Value="False"/></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}"/></MultiTrigger>
    <Trigger Property="helpers:ContactSelection.IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillPressedBrush}"/></Trigger>
    <DataTrigger Binding="{Binding IsSelected,ElementName=Root}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}"/></DataTrigger>
   </Style.Triggers></Style></Border.Style>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource UnreadDotBrush}" Visibility="{Binding HasUnread,ElementName=Root,Converter={StaticResource BoolToVis}}"/>
   <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center" Background="{DynamicResource AccentSoftFillBrush}"><Image Width="36" Height="36" Stretch="UniformToFill" helpers:Cover.ImageDecodeWidth="128" helpers:Cover.ImageSource="{Binding Avatar,ElementName=Root}"><Image.Clip><EllipseGeometry Center="18,18" RadiusX="18" RadiusY="18"/></Image.Clip></Image></Border>
   <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
    <TextBlock Text="{Binding Title,ElementName=Root}" FontSize="13" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected,ElementName=Root}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <TextBlock Text="{Binding Subtitle,ElementName=Root}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding Subtitle,ElementName=Root,Converter={StaticResource StrToVis}}"/>
   </StackPanel>
  </Grid>
 </Border>
</UserControl>