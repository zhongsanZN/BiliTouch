<UserControl x:Class="BiliTouch.Views.Pages.DynamicDetailPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:BiliTouch.Views.Controls" xmlns:helpers="clr-namespace:BiliTouch.Helpers"
 Background="{DynamicResource AppBackgroundBrush}">
 <UserControl.Resources>
  <Style x:Key="CommentReactionText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
   <Style.Triggers><DataTrigger Binding="{Binding IsLiked}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" /></DataTrigger></Style.Triggers>
  </Style>
  <DataTemplate x:Key="ReplyTemplate">
   <Border Margin="0,6,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource ControlFillHoverBrush}">
    <StackPanel>
     <controls:CommentText Comment="{Binding}" Prefix="{Binding ReplyPrefix}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
     <Button Content="回复" Click="OnReplyToReply" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" />
    </StackPanel>
   </Border>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="16,8">
  <!-- 2026-11-04 修"动态详情页底部内容被裁切":
       原来是 [* / Auto], 底部评论输入区在 Auto 行。窗口一矮, Auto 行**不能被压缩**,
       整页就超出窗口, 输入框被裁掉一截(用户截图: "发表评论"框只剩半截)。
       现在: 上面给 MinHeight 保住可读区域, 底部给 MaxHeight 让输入框自己滚;
       两行都受限, 窗口再矮也不会把任何一块挤到窗口外。 -->
  <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="3*" MinWidth="280"/><ColumnDefinition Width="2*" MinWidth="300"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
    <StackPanel>
     <controls:DynamicFeedCard DataContext="{Binding Item}" IsDetail="True" MaxWidth="800" CommentRequested="OnFocusComment" RepostRequested="OnFocusRepost" />
     <TextBlock Text="{Binding DetailError}" Visibility="{Binding DetailError, Converter={StaticResource StrToVis}}" TextWrapping="Wrap" Margin="12,6" Foreground="{DynamicResource DangerTextBrush}" />
     <controls:LoadingRing Width="18" Height="18" Visibility="{Binding DetailLoading, Converter={StaticResource BoolToVis}}" />
     <Button Content="重新加载完整内容" Visibility="{Binding DetailError, Converter={StaticResource StrToVis}}" HorizontalAlignment="Left" Margin="12,6" Click="OnReloadDetail" Style="{StaticResource SubtleButtonStyle}" />

     <!-- ===== 评论图片的内联查看区(2026-11-04) =====
          用户反馈两点, 合起来就是这一块:
            ① 点开评论图片是"生硬地弹出窗口", 不是原生查看;
            ② 动态详情页左下角空空的, 那块正好适合放要看的图片。
          所以: 点评论里的图片 → **不弹窗**, 就在这儿原地显示大图。
          行为照官方: 双击 1:1 / 适应切换, 支持上一张下一张、点开原图、保存。
          ★ 只在真的点过图片后才占高度(Visibility=Collapsed 时不占位),
            不会把正常浏览时的版面顶下去。 -->
     <Border x:Name="InlineImageHost" Margin="12,12,12,0" CornerRadius="10"
             Background="{DynamicResource CardBackgroundBrush}"
             BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
             Visibility="Collapsed">
      <StackPanel>
       <!-- 标题行: 谁发的 + 第几张/共几张 + 关闭 -->
       <Grid Margin="12,10,10,6">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
         <TextBlock Text="&#xE8B9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                    FontSize="13" VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentTextBrush}" />
         <TextBlock x:Name="InlineImageTitle" Text="评论图片" FontSize="13" FontWeight="SemiBold"
                    Margin="8,0,0,0" VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" MaxWidth="380" />
         <TextBlock x:Name="InlineImageIndex" Text="" FontSize="12" Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
         <Button x:Name="InlineImagePrev" Content="&#xE76B;" Click="OnInlineImagePrev"
                 Style="{StaticResource IconButtonStyle}" ToolTip="上一张" />
         <Button x:Name="InlineImageNext" Content="&#xE76C;" Click="OnInlineImageNext"
                 Style="{StaticResource IconButtonStyle}" Margin="4,0,0,0" ToolTip="下一张" />
         <Button Content="&#xE8B9;" Click="OnInlineImageOpen" Margin="4,0,0,0"
                 Style="{StaticResource IconButtonStyle}" ToolTip="用图片查看器打开(可缩放/保存)" />
         <Button Content="&#xE711;" Click="OnInlineImageClose" Margin="4,0,0,0"
                 Style="{StaticResource IconButtonStyle}" ToolTip="关闭(Esc)" />
        </StackPanel>
       </Grid>
       <!-- 图片本体: 高度随窗口, 宽度按比例, 不裁 -->
       <Border x:Name="InlineImageFrame" Margin="12,0,12,10" CornerRadius="8"
               ClipToBounds="True" Height="320"
               Background="{DynamicResource PlaceholderBrush}">
        <Grid>
         <Border x:Name="InlineImageSurface"
                 helpers:Cover.Fill="True"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
         <controls:LoadingRing x:Name="InlineImageLoading" Width="24" Height="24"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed" />
         <TextBlock x:Name="InlineImageError" Text="" FontSize="12" TextWrapping="Wrap"
                    Margin="16" TextAlignment="Center"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Foreground="{DynamicResource TextTertiaryBrush}"
                    Visibility="Collapsed" />
        </Grid>
       </Border>
       <TextBlock Text="点「用图片查看器打开」可缩放/保存 · Esc 关闭"
                  FontSize="11" Margin="12,0,12,10"
                  Foreground="{DynamicResource TextTertiaryBrush}" />
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <Grid x:Name="CommentsPane" Grid.Column="1">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="8,6,8,10">
     <controls:LoadingRing Width="18" Height="18" HorizontalAlignment="Left" Margin="50,0,0,0" Visibility="{Binding Loading,Converter={StaticResource BoolToVis}}"/>
     <TextBlock Text="评论" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <RadioButton Content="最热" GroupName="CommentSort" IsChecked="True" Checked="OnHot" Margin="8,0" />
      <RadioButton Content="最新" GroupName="CommentSort" Checked="OnNewest" Margin="8,0" />
     </StackPanel>
    </Grid>

    <ListBox x:Name="CommentList" Grid.Row="1" ScrollViewer.ScrollChanged="OnCommentsScroll" ItemsSource="{Binding Comments}" Background="Transparent" BorderThickness="0"
     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate>
      <DataTemplate>
       <Border Padding="12" Margin="0,0,0,8" CornerRadius="8" Background="{DynamicResource CardBackgroundBrush}">
        <StackPanel>
         <StackPanel Orientation="Horizontal">
          <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="OnAuthor" helpers:Cover.Source="{Binding UserFace}" />
          <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" />
          <TextBlock Text="置顶" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextBrush}" Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
         </StackPanel>
         <controls:CommentText Comment="{Binding}" Margin="0,8,0,0" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
         <ItemsControl ItemsSource="{Binding Pictures}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="90" Height="80" Margin="3" helpers:Cover.Source="{Binding Url}" MouseLeftButtonUp="OnCommentPicture" Cursor="Hand"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
         <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
          <TextBlock Text="{Binding RcTime}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,8,0" />
          <Button Click="OnLike" IsEnabled="{Binding CanLike}" ToolTip="点赞/取消点赞" Style="{StaticResource SubtleButtonStyle}"><StackPanel Orientation="Horizontal"><TextBlock Text="赞 " Style="{StaticResource CommentReactionText}"/><TextBlock Text="{Binding LikeText}" Style="{StaticResource CommentReactionText}"/></StackPanel></Button>
          <Button Content="回复" Click="OnReply" Style="{StaticResource SubtleButtonStyle}" Margin="6,0" />
         </StackPanel>
         <ItemsControl ItemsSource="{Binding Replies}" ItemTemplate="{StaticResource ReplyTemplate}" />
         <Button Content="{Binding ReplyMoreText}" Click="OnReplies" Visibility="{Binding HasMoreReplies, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}" />
        </StackPanel>
       </Border>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
   <Border x:Name="CommentComposerHost" Grid.Row="2" Margin="8,8,8,0" Padding="10" CornerRadius="10" Background="{DynamicResource CardBackgroundBrush}">
     <StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding Status,Converter={StaticResource StrToVis}}"/>
      <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource DangerTextBrush}" Visibility="{Binding Error,Converter={StaticResource StrToVis}}"/>
      <Button Content="重试加载评论" Click="OnRetry" Visibility="{Binding Error,Converter={StaticResource StrToVis}}" HorizontalAlignment="Left" Style="{StaticResource SubtleButtonStyle}"/>
      <StackPanel Orientation="Horizontal" Visibility="{Binding HasReplyTarget,Converter={StaticResource BoolToVis}}">
       <TextBlock Text="{Binding ComposerTitle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240"/>
       <Button Content="取消" Click="OnCancelReply" Style="{StaticResource SubtleButtonStyle}" Margin="8,0"/>
      </StackPanel>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Margin="0,0,8,0">
        <TextBox x:Name="Composer" Style="{StaticResource FluentTextBoxStyle}" Text="{Binding Draft,UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="88" MaxLength="1000" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanEdit}" PreviewKeyDown="OnComposerKey" ToolTip="Ctrl+Enter 发送"/>
        <TextBlock Text="说点什么…" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding Draft,Converter={StaticResource InvStrToVis}}"/>
       </Grid>
       <Button Grid.Column="1" Content="发送" Click="OnSend" IsEnabled="{Binding CanSend}" Style="{StaticResource AccentButtonStyle}" MinHeight="44" Padding="16,6" VerticalAlignment="Bottom"/>
      </Grid>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>

 </Grid>
</UserControl>
