<views:FluentWindow x:Class="BiliDesk.Views.LiveRoomWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:BiliDesk.Views"
    xmlns:helpers="clr-namespace:BiliDesk.Helpers"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="BiliTouch 直播间" Width="1360" Height="840" MinWidth="840" MinHeight="540"
    WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <views:FluentWindow.Resources>
        <Style x:Key="LiveControl" TargetType="Button" BasedOn="{StaticResource SubtleButtonStyle}">
            <Setter Property="Foreground" Value="White"/><Setter Property="MinHeight" Value="40"/>
            <Setter Property="MinWidth" Value="40"/><Setter Property="Padding" Value="10,4"/><Setter Property="Focusable" Value="False"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Hit" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/></Style></ContentPresenter.Resources>
                    </ContentPresenter>
                </Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hit" Property="Background" Value="#25FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Hit" Property="Background" Value="#40FFFFFF"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="ChatTemplate">
            <Border x:Name="MessageBody" Padding="12,7" CornerRadius="8" Margin="2,2">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding User}" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnCardBrush}" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Identity}" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding Identity,Converter={StaticResource StrToVis}}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="SuperChat"><Setter TargetName="MessageBody" Property="Background" Value="{DynamicResource AccentSoftFillStrongBrush}"/></DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </views:FluentWindow.Resources>
    <Grid x:Name="Root" Background="{DynamicResource CardBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition x:Name="ChromeRow" Height="44"/><RowDefinition x:Name="HeaderRow" Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid x:Name="TitleBar" Margin="16,0,6,0">
            <TextBlock Text="BiliTouch  /  直播" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Content="—" Width="44" Style="{StaticResource SubtleButtonStyle}" Click="MinimizeClick" ToolTip="最小化"/>
                <Button Content="□" Width="44" Style="{StaticResource SubtleButtonStyle}" Click="MaximizeClick" ToolTip="最大化 / 还原"/>
                <Button Content="×" Width="44" Style="{StaticResource SubtleButtonStyle}" Click="CloseClick" ToolTip="关闭直播间"/>
            </StackPanel>
        </Grid>
        <Grid x:Name="RoomHeader" Grid.Row="1" Margin="20,6,20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <WrapPanel Margin="0,8,0,0">
                    <Border Background="{DynamicResource AccentSoftFillBrush}" Padding="8,2" CornerRadius="5" Margin="0,0,10,0"><TextBlock Text="{Binding LiveStateText}" FontSize="11" Foreground="{DynamicResource AccentTextOnCardBrush}"/></Border>
                    <TextBlock Text="{Binding Anchor}" Margin="0,2,12,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Area}" Margin="0,2,12,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding RoomText}" Margin="0,2,12,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                    <TextBlock Text="{Binding Watched}" Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
                </WrapPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <Button x:Name="FollowButton" Content="{Binding FollowText}" Style="{StaticResource AccentButtonStyle}" Click="FollowClick" MinWidth="76"/>
                <Button Content="↗" Style="{StaticResource SubtleButtonStyle}" Click="OpenBrowserClick" ToolTip="在浏览器打开直播间" Margin="8,0,0,0" FontSize="20"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" x:Name="RoomLayout">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="ChatColumn" Width="360"/></Grid.ColumnDefinitions>
            <Grid Background="#101116" x:Name="VideoPanel">
                <vlc:VideoView x:Name="LiveVideo">
                    <Grid x:Name="VideoOverlay" Background="Transparent" MouseLeftButtonDown="VideoMouseDown">
                        <Canvas x:Name="LiveCanvas" ClipToBounds="True" IsHitTestVisible="False" Margin="0,0,0,56"/>
                        <StackPanel x:Name="PlaybackState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24">
                            <Image Source="/BiliDesk;component/Assets/app.png" Width="64" Height="64" Margin="0,0,0,16"/>
                            <TextBlock x:Name="PlaybackStateText" Text="正在连接直播…" Foreground="White" FontSize="19" TextAlignment="Center" TextWrapping="Wrap"/>
                            <Button Content="重新连接" Click="ReconnectClick" Style="{StaticResource LiveControl}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="LiveControls" VerticalAlignment="Bottom" Background="#E6191A20" Height="56" Padding="12,4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button x:Name="PauseButton" Content="Ⅱ" Click="PauseClick" Style="{StaticResource LiveControl}" ToolTip="暂停 / 播放（空格）"/>
                                <Button Grid.Column="1" Content="↻" Click="ReconnectClick" Style="{StaticResource LiveControl}" ToolTip="回到实时画面 / 重新连接" FontSize="20"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="MuteButton" Content="♪" Click="MuteClick" Style="{StaticResource LiveControl}" ToolTip="静音（M）"/>
                                    <Slider x:Name="LiveVolume" Width="66" Minimum="0" Maximum="100" ValueChanged="VolumeChanged" VerticalAlignment="Center" ToolTip="音量" IsMoveToPointEnabled="True" Focusable="False"/>
                                </StackPanel>
                                <ComboBox Grid.Column="4" x:Name="QualityBox" MinWidth="80" MaxWidth="125" Margin="6,0" VerticalAlignment="Center" Foreground="#15161B" Background="#E9EBF0" SelectionChanged="QualityChanged" ToolTip="直播清晰度">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Foreground="#15161B"/></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="5" x:Name="OverlayButton" Click="OverlayClick" Style="{StaticResource LiveControl}" ToolTip="画面弹幕开关">
                                    <Grid Width="20" Height="20"><Path Data="M1,2 L19,2 19,16 13,16 10,19 7,16 1,16 Z M5,6 L15,6 M5,10 L12,10" Stroke="White" StrokeThickness="1.5"/><Path x:Name="OverlayOff" Data="M0,20 L20,0" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Grid>
                                </Button>
                                <Button Grid.Column="6" x:Name="LiveSettingsButton" Content="弹幕设置" Click="OverlaySettingsClick" Style="{StaticResource LiveControl}" FontSize="12"/>
                                <Button Grid.Column="7" Content="☷" Click="ChatToggleClick" Style="{StaticResource LiveControl}" ToolTip="侧边弹幕面板"/>
                                <Button Grid.Column="8" Content="⛶" Click="FullscreenClick" Style="{StaticResource LiveControl}" FontSize="22" ToolTip="全屏（F / 双击），Esc 退出"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="LiveSettingsPopup" PlacementTarget="{Binding ElementName=LiveSettingsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource FlyoutBackgroundBrush}" BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18" Width="290">
                                <StackPanel>
                                    <TextBlock Text="弹幕设置" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>
                                    <TextBlock Text="显示区域"/><Slider x:Name="AreaSetting" Minimum="25" Maximum="100" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="OverlaySettingChanged" Margin="0,6,0,12"/>
                                    <TextBlock Text="不透明度"/><Slider x:Name="OpacitySetting" Minimum="20" Maximum="100" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="OverlaySettingChanged" Margin="0,6,0,12"/>
                                    <TextBlock Text="字号"/><Slider x:Name="FontSetting" Minimum="50" Maximum="200" TickFrequency="25" IsSnapToTickEnabled="True" ValueChanged="OverlaySettingChanged" Margin="0,6,0,12"/>
                                    <TextBlock Text="速度（慢 → 快）"/><Slider x:Name="SpeedSetting" Minimum="0" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OverlaySettingChanged" Margin="0,6,0,12"/>
                                    <CheckBox x:Name="ColorSetting" Content="彩色弹幕" Checked="ColorSettingChanged" Unchecked="ColorSettingChanged"/>
                                    <TextBlock Text="屏蔽词沿用设置页中的弹幕规则" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </vlc:VideoView>
            </Grid>
            <Border Grid.Column="1" x:Name="ChatPanel" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="16,14,12,10">
                        <Button DockPanel.Dock="Right" Content="清屏" Style="{StaticResource SubtleButtonStyle}" Click="ClearChatClick" MinHeight="28" FontSize="11"/>
                        <StackPanel><TextBlock Text="实时弹幕" FontWeight="SemiBold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding ConnectionText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
                    </DockPanel>
                    <Expander Grid.Row="1" Header="直播公告" Margin="16,0,16,8" Visibility="{Binding Announcement,Converter={StaticResource StrToVis}}">
                        <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Announcement}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8"/></ScrollViewer>
                    </Expander>
                    <Border Grid.Row="2" Background="{DynamicResource AccentSoftFillBrush}" Margin="12,0,12,8" Padding="10" CornerRadius="10" Visibility="{Binding HasSuperChats,Converter={StaticResource BoolToVis}}">
                        <StackPanel><TextBlock Text="醒目留言 · SC" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextOnCardBrush}" Margin="2,0,0,6"/>
                            <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ActiveSuperChats}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Padding="8" Background="{DynamicResource CardBackgroundBrush}" Margin="0,3" CornerRadius="6"><StackPanel>
                                    <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding RemainingText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/><TextBlock Foreground="{DynamicResource AccentTextOnCardBrush}" TextTrimming="CharacterEllipsis"><Run Text="{Binding PriceText,Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding User,Mode=OneWay}"/></TextBlock></DockPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                                </StackPanel></Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="3">
                        <ListBox x:Name="ChatList" ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource ChatTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.ScrollChanged="ChatScrollChanged" PreviewMouseWheel="ChatWheel" PreviewTouchDown="ChatTouchDown">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                        </ListBox>
                        <Button x:Name="LatestButton" Content="回到最新弹幕" Click="LatestClick" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="10" Style="{StaticResource AccentButtonStyle}" Visibility="Collapsed"/>
                    </Grid>
                    <StackPanel Grid.Row="4" Margin="16,8,16,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Visibility="{Binding StatusText,Converter={StaticResource StrToVis}}"/>
                        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" FontSize="11" Visibility="{Binding Error,Converter={StaticResource StrToVis}}"/>
                    </StackPanel>
                    <Grid Grid.Row="5" Margin="12,10,12,14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="ChatInput" Style="{StaticResource FluentTextBoxStyle}" MinHeight="40" MaxLength="100" VerticalContentAlignment="Center" KeyDown="ChatInputKeyDown" ToolTip="发送直播弹幕（最多 100 字，Enter 发送）"/>
                        <Button x:Name="SendButton" Grid.Column="1" Content="发送" Style="{StaticResource AccentButtonStyle}" Click="SendClick" IsEnabled="{Binding IsSending,Converter={StaticResource InvBool}}" Margin="8,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</views:FluentWindow>
