<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 源配置: 优先官方源, 失败时自动使用中国区镜像, 并启用包源映射防止多源依赖混淆 (NU1507) -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="azure-cn" value="https://nuget.azure.cn/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="azure-cn">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>
