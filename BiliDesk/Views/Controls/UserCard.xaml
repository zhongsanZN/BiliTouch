<UserControl x:Class="BiliDesk.Views.Controls.UserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Cursor="Hand" Background="Transparent"
             MouseLeftButtonUp="OnClick">
    <!--
        搜索结果的用户卡(2026-11-04 新增)。

        ★ 为什么单独做一个控件而不是复用 VideoCard: 数据模型完全不同
          (UserItem 是 mid/头像/粉丝/签名, 没有封面/时长/bvid), 硬塞进 VideoCard
          会让那个控件里多出一半永远走不到的分支。
        ★ 版式照官方 PC 端搜索结果: 左圆头像 + 右两行(昵称[认证标] / 粉丝·签名)。
          官方号额外加一枚"官方"徽章 —— 搜作品名时第一眼就能认出官方账号。
    -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="12,10" Margin="8,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 头像: 圆形裁切, 按 44px 宽解码(小图省内存, 与评论头像同一做法) -->
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    Background="{DynamicResource AccentSoftFillBrush}"
                    ClipToBounds="True" VerticalAlignment="Center">
                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
            </Border>

            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <!-- 昵称 + 认证 -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="220"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <!-- 认证徽章: 官方(机构认证)蓝色实心; 其它认证用描边, 弱一档 -->
                    <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            Visibility="{Binding IsOfficial, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="官方" FontSize="9" FontWeight="SemiBold"
                                   Foreground="White" />
                    </Border>
                    <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                            Visibility="{Binding VerifyLabel, Converter={StaticResource StrToVis}}">
                        <TextBlock Text="UP主认证" FontSize="9"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                </StackPanel>

                <!-- 粉丝数 · 签名 -->
                <TextBlock FontSize="11.5" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding FansText, Mode=OneWay}" />
                    <Run Text="  ·  " />
                    <Run Text="{Binding Sign, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
