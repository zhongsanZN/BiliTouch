<UserControl x:Class="BiliDesk.Views.Controls.DynamicFeedCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="Transparent" Focusable="False">
    <!--
        动态混合流的一条(2026-11-04)。

        对标官方手机端: 一条动态 = 抬头(头像+昵称+时间) + 正文 + 内容区 + 互动行。
        内容区按 DynamicItem.Kind 换模板:
          · 视频   → 左封面右标题(点击播放)
          · 图文   → 图片九宫格(1 张走单图, 2/4 张两列, 其余三列)
          · 纯文字 → 只有正文
          · 转发   → 正文(转发理由) + 原动态引用框
          · 专栏   → 左封面右标题(点击进专栏)
          · 直播   → 左封面右标题(点击进直播间)

        ★ 为什么一个控件内切换而不是每种类型一个控件:
          抬头、正文、互动行三者完全一样, 拆开要复制三遍且容易漂移;
          只有内容区不同, 用一个 ContentControl + DataTemplateSelector 最省。
    -->
    <UserControl.Resources>
        <!-- ===================== 图片九宫格 ===================== -->
        <DataTemplate x:Key="DynPicturesTemplate">
            <ItemsControl ItemsSource="{Binding Pictures}" HorizontalAlignment="Left"
                          x:Name="PicHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:DynamicPicturePanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- ★ 2026-11-04: 图片可点(官方是点图进看图器)。
                             Cursor=Hand + MouseLeftButtonUp 转发给卡片 code-behind。
                             高度由 DynamicPicturePanel.TileHeight 决定(单图 180 / 多图 96)。 -->
                        <Border Margin="2" CornerRadius="6" ClipToBounds="True"
                                Cursor="Hand"
                                MouseLeftButtonUp="OnPictureClick"
                                Background="{DynamicResource PlaceholderBrush}"
                                Height="{Binding TileHeight,
                                                 RelativeSource={RelativeSource AncestorType=controls:DynamicPicturePanel}}">
                            <Image Source="{Binding Url}" Stretch="UniformToFill" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <!-- ===================== 视频附加卡 ===================== -->
        <!-- ★ 2026-11-04 改成官方那种"大封面 + 下方标题"布局:
             原来是小缩略图(150×84)在左、标题在右, 视觉上像一条列表项, 用户说"预览不了视频"。
             官方 PC 客户端的动态里视频是**整块封面预览**(约 16:9, 占满卡片宽度),
             标题/UP/播放数在封面下方 —— 这样一眼就能看出视频内容。 -->
        <DataTemplate x:Key="DynVideoTemplate">
            <Border CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                    Background="{DynamicResource ControlFillHoverBrush}"
                    MouseLeftButtonUp="OnContentClick">
                <StackPanel>
                    <!-- 封面: 占满卡片宽度, 8:5 比例(接近官方预览比例) -->
                    <Border CornerRadius="6" ClipToBounds="True" Margin="0,0,0,8"
                            Background="{DynamicResource PlaceholderBrush}">
                        <Grid>
                            <Image Source="{Binding Video.Cover}" Stretch="UniformToFill"
                                   Height="220" />
                            <!-- 时长角标 -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,6,6" CornerRadius="3" Padding="5,1"
                                    Background="{DynamicResource DurationBadgeBackgroundBrush}"
                                    Visibility="{Binding Video.DurationText, Converter={StaticResource StrToVis}}">
                                <TextBlock Text="{Binding Video.DurationText}" FontSize="10.5" Foreground="White" />
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Margin="2,0,2,0">
                        <TextBlock Text="{Binding Video.Title}" FontSize="13.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxHeight="42" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Video.ViewCountText}" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ===================== 专栏附加卡 ===================== -->
        <DataTemplate x:Key="DynArticleTemplate">
            <Border CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                    Background="{DynamicResource ControlFillHoverBrush}"
                    MouseLeftButtonUp="OnContentClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="84" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource PlaceholderBrush}">
                        <Image Source="{Binding ArticleCover}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ArticleTitle}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="专栏" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===================== 直播附加卡 ===================== -->
        <DataTemplate x:Key="DynLiveTemplate">
            <Border CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                    Background="{DynamicResource ControlFillHoverBrush}"
                    MouseLeftButtonUp="OnContentClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Height="84" CornerRadius="6" ClipToBounds="True"
                            Background="{DynamicResource PlaceholderBrush}">
                        <Image Source="{Binding Video.Cover}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="直播中" FontSize="11" Margin="0,6,0,0"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===================== 转发引用框 ===================== -->
        <DataTemplate x:Key="DynForwardTemplate">
            <Border CornerRadius="8" Padding="10" Cursor="Hand"
                    Background="{DynamicResource ControlFillHoverBrush}"
                    MouseLeftButtonUp="OnContentClick">
                <StackPanel>
                    <!-- 原动态已删除 -->
                    <TextBlock Text="原动态已删除" FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding OriginalDeleted, Converter={StaticResource BoolToVis}}" />
                    <!-- 原动态存在: 作者 + 正文 + 图 -->
                    <StackPanel Visibility="{Binding OriginalDeleted, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding Original.AuthorName}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                        <TextBlock Text="{Binding Original.Text}" TextWrapping="Wrap" FontSize="12.5"
                                   Margin="0,4,0,0" MaxHeight="120" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Original.HasText, Converter={StaticResource BoolToVis}}" />
                        <ContentControl Content="{Binding Original}" Margin="0,8,0,0"
                                        ContentTemplate="{StaticResource DynPicturesTemplate}"
                                        Visibility="{Binding Original.HasPictures, Converter={StaticResource BoolToVis}}" />
                        <!-- 原动态是视频时再挂一张小卡 -->
                        <Border CornerRadius="6" Margin="0,8,0,0" Padding="8" Cursor="Hand"
                                Background="{DynamicResource CardBackgroundBrush}"
                                MouseLeftButtonUp="OnContentClick"
                                Visibility="{Binding Original.Video, Converter={StaticResource NotNullToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="72" Height="41" CornerRadius="4" ClipToBounds="True"
                                        Background="{DynamicResource PlaceholderBrush}">
                                    <Image Source="{Binding Original.Video.Cover}" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="{Binding Original.Video.Title}" FontSize="12"
                                           Margin="8,0,0,0" VerticalAlignment="Center"
                                           TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <controls:DynamicContentSelector x:Key="DynamicContentSelector"
                                         VideoTemplate="{StaticResource DynVideoTemplate}"
                                         PictureTemplate="{StaticResource DynPicturesTemplate}"
                                         ForwardTemplate="{StaticResource DynForwardTemplate}"
                                         ArticleTemplate="{StaticResource DynArticleTemplate}"
                                         LiveTemplate="{StaticResource DynLiveTemplate}" />
    </UserControl.Resources>

    <!-- ★ 整卡可点(2026-11-04): 官方客户端点一下动态就进详情(完整内容 + 全部评论)。
         子元素(头像/视频卡/图片/按钮)先处理并设 Handled, 所以它们各自的动作不受影响。 -->
    <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="14,12" Margin="8,6"
            Cursor="Hand" MouseLeftButtonUp="OnCardClick">
        <StackPanel>
            <!-- ===== 抬头: 头像 + 昵称 + 时间 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{DynamicResource AccentSoftFillBrush}"
                        ClipToBounds="True" VerticalAlignment="Top"
                        Cursor="Hand" MouseLeftButtonUp="OnAuthorClick">
                    <Image Source="{Binding AuthorFace}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AuthorName}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource AccentTextBrush}"
                               Cursor="Hand" MouseLeftButtonUp="OnAuthorClick" />
                    <TextBlock Text="{Binding PubTimeText}" FontSize="11" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- ===== 正文(转发理由 / 图文正文 / 纯文字) ===== -->
            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13.5" Margin="0,9,0,0"
                       LineHeight="21" MaxHeight="180" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}" />

            <!-- ===== 内容区: 按类型切换 ===== -->
            <!-- ★★★ 2026-11-04 修"卡片上直接印着 BiliDesk.Models.DynamicItem":
                 模板选择器对纯文字/未知类型返回 null, 而 ContentControl 在选中 null 模板时
                 会走**默认模板** —— 没有 ContentTemplate 就用 `Content.ToString()` 渲染。
                 DynamicItem 没重写 ToString, 于是把类型名打了出来。
                 修法: 用 Visibility 绑 HasAttachedCard 整块藏掉, 让选择器返回 null 时
                 **根本不参与布局**, 从源头断掉默认渲染。
                 (不要改成"给一个空 DataTemplate"—— 那会留下 Margin 与空隙。) -->
            <ContentControl Content="{Binding}" Margin="0,9,0,0"
                            Visibility="{Binding HasAttachedCard, Converter={StaticResource BoolToVis}}"
                            ContentTemplateSelector="{StaticResource DynamicContentSelector}" />

            <!-- ===== 热评(B 站 PC 客户端把评论直接挂在动态下面) ===== -->
            <ItemsControl ItemsSource="{Binding TopComments}" Margin="0,10,0,0"
                          Visibility="{Binding HasComments, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource ControlFillHoverBrush}"
                                CornerRadius="6" Padding="9,7" Margin="0,0,0,5">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UserName}" FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                    <TextBlock Text="  ·  " FontSize="11.5"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding LikeText}" FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                           Margin="0,3,0,0" MaxHeight="60"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== 互动行 ===== -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                            Visibility="{Binding ForwardText, Converter={StaticResource StrToVis}}">
                    <TextBlock Text="&#xE72A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ForwardText}" FontSize="11.5" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0"
                            Visibility="{Binding CommentText, Converter={StaticResource StrToVis}}">
                    <TextBlock Text="&#xE8F2;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CommentText}" FontSize="11.5" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding LikeText, Converter={StaticResource StrToVis}}">
                    <TextBlock Text="&#xE8E1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LikeText}" FontSize="11.5" Margin="4,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
