<UserControl x:Class="BiliDesk.Views.Pages.MessagesPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:BiliDesk.Views.Controls" xmlns:helpers="clr-namespace:BiliDesk.Helpers"
 Background="{DynamicResource AppBackgroundBrush}">
 <UserControl.Resources><helpers:MessageCardWidthConverter x:Key="MessageCardWidth"/></UserControl.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="24,20,24,8" MinHeight="62">
   <TextBlock Text="私信" Style="{StaticResource PageTitleStyle}" VerticalAlignment="Top"/>
   <Button HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource IconButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="刷新"><TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"/></Button>
  </Grid>
  <Grid Grid.Row="1">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="{Binding Error,Converter={StaticResource StrToVis}}"><TextBlock Text="{Binding Error}" TextWrapping="Wrap"/><Button Content="重试" Style="{StaticResource SubtleButtonStyle}" Command="{Binding RefreshCommand}" Margin="0,16,0,0"/></StackPanel>
   <Grid Visibility="{Binding Error,Converter={StaticResource InvStrToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer x:Name="SessionScroll" Grid.Column="0" Margin="12,4,0,20" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="8,0,8,0"><controls:LoadingRing HorizontalAlignment="Center" Margin="0,12" Visibility="{Binding Loading,Converter={StaticResource BoolToVis}}"/>
      <ItemsControl x:Name="SessionList" ItemsSource="{Binding Sessions}"><ItemsControl.ItemTemplate><DataTemplate><controls:ContactListRow Title="{Binding DisplayName}" Subtitle="{Binding Preview}" Avatar="{Binding Face}" IsSelected="{Binding IsSelected}" HasUnread="{Binding HasUnread}" MouseLeftButtonUp="OnSessionClick"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Column="1" Margin="12,4,24,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding CurrentTitle}" FontSize="15" FontWeight="SemiBold" Margin="8,0,8,10" TextTrimming="CharacterEllipsis"/>
     <Grid Grid.Row="1">
      <ScrollViewer x:Name="MsgScroll" VerticalScrollBarVisibility="Auto" ScrollChanged="OnThreadScroll" Padding="8,8,8,8">
       <StackPanel><controls:LoadingRing Width="18" Height="18" HorizontalAlignment="Center" Margin="0,8" Visibility="{Binding LoadingOlder,Converter={StaticResource BoolToVis}}"/>
        <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Margin="0,0,0,16">
          <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Center" FontSize="10" Margin="0,0,0,8" Foreground="{DynamicResource TextTertiaryBrush}"/>
          <Border CornerRadius="10" Padding="12" MaxWidth="480">
           <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding IsMine}" Value="True"><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Background" Value="{DynamicResource AccentSoftFillBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
           <StackPanel>
            <Image MaxWidth="320" MaxHeight="300" Stretch="Uniform" helpers:Cover.ImageSource="{Binding ImageUrl}" Visibility="{Binding IsImage,Converter={StaticResource BoolToVis}}" MouseLeftButtonUp="OnMessageImageClick" Cursor="Hand"/>
            <TextBox Text="{Binding Text,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="13" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" Visibility="{Binding IsText,Converter={StaticResource BoolToVis}}"/>
            <StackPanel Visibility="{Binding IsCard,Converter={StaticResource BoolToVis}}" Width="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer},Converter={StaticResource MessageCardWidth}}">
             <TextBlock Text="{Binding KindLabel}" FontSize="10" Margin="0,0,0,8" Foreground="{DynamicResource AccentTextBrush}"/>
             <Border Margin="0,0,0,10" CornerRadius="8" Visibility="{Binding HasCover,Converter={StaticResource BoolToVis}}" Background="{DynamicResource InputBackgroundBrush}"><Image Height="{Binding ActualWidth,RelativeSource={RelativeSource AncestorType=ScrollViewer},Converter={StaticResource MessageCardWidth},ConverterParameter=height}" Stretch="UniformToFill" helpers:Cover.ImageSource="{Binding CoverUrl}" MouseLeftButtonUp="OnMessageCardClick" Cursor="Hand"/></Border>
             <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MouseLeftButtonUp="OnMessageCardClick" Cursor="Hand"/>
             <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="{Binding Description,Converter={StaticResource StrToVis}}"/>
             <Button Content="打开" Margin="0,10,0,0" HorizontalAlignment="Left" MinHeight="36" Padding="14,5" Style="{StaticResource SubtleButtonStyle}" Click="OnMessageCardOpen" Visibility="{Binding CanOpen,Converter={StaticResource BoolToVis}}"/>
             <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Url}" Style="{StaticResource SubtleButtonStyle}" Margin="0,0,8,4" MinHeight="36" Click="OnMessageAction"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
           </StackPanel>
          </Border>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel>
      </ScrollViewer>
      <controls:LoadingRing HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ThreadLoading,Converter={StaticResource BoolToVis}}"/>
      <TextBlock Text="{Binding ThreadError}" VerticalAlignment="Top" Margin="12,8" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding ThreadError,Converter={StaticResource StrToVis}}"/>
     </Grid>
     <Grid Grid.Row="2" Margin="8,10,8,0" Visibility="{Binding CanCompose,Converter={StaticResource BoolToVis}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="DraftBox" Text="{Binding Draft,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBoxStyle}" MinHeight="44" MaxHeight="100" MaxLength="500" KeyDown="OnDraftKeyDown" IsEnabled="{Binding CanCompose}"/>
      <Button Grid.Column="1" Content="发送" Command="{Binding SendCommand}" IsEnabled="{Binding CanSend}" MinHeight="44" Margin="10,0,0,0" Style="{StaticResource AccentButtonStyle}" Padding="20,8"/>
     </Grid>
    </Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>